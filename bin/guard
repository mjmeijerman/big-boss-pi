#!/bin/sh
# guard moved to the pi repo (~/.pi/bin/guard); this shim stays for scripts that call it by this path.
tool="$HOME/.pi/bin/guard"
if [ ! -x "$tool" ]; then
	printf 'bin/guard: %s is missing — the tool lives in the pi repo (~/.pi/bin/guard); install it there\n' "$tool" >&2
	exit 127
fi
exec "$tool" "$@"
