#!/usr/bin/env bash
# guard — keeps the big-boss-pi space alive.
#
# Herdr has no per-space lock: space.close ends a space and its terminals, and no hook lets a
# mod veto it. So the space is made self-healing instead. Every few seconds: is there a space
# named big-boss-pi? If not, rebuild it with a fresh big-boss-pi agent. The first time Herdr
# answers after this service starts, select it, so Herdr opens on big-boss-pi.
#
# herdr-core parks kept terminals and gives them a shell on the next start, so a restart leaves
# the space with its tabs ("master", "Pi (bare)") and no agents in them: tabs that say Pi over
# a prompt. ensure() repairs those.
#
# A repair prefers the session that was there. Every hc terminal that ran pi has a resume entry in
# ~/.pi/agent/herdr-resume/<terminal>.json (agent/extensions/herdr-resume-map.ts), and
# ~/.pi/scripts/herdr-resume.mjs knows how to type `exec <argv> --session <path>` back into the
# recovered shell. So a stale tab with an entry is resumed — same conversation, same tab — and only
# a tab that never held pi (no entry) is closed and opened again with an absolute argv, so the core
# can restart it later: the holder's PATH has no pnpm bin dir, so a bare `pi-bare` cannot be
# restarted. A resume that does not end with pi running falls back to that same reopen.
#
# The entry is looked up by terminal id **or** by the tab id the entry recorded: after a host
# reboot herdr-app reports no terminal for a parked tab, so a terminal-only lookup sees nothing
# and reopens the tab fresh over a conversation that is still on disk. The newest entry wins and
# its session file has to exist. And when herdr-resume.mjs declines a terminal — typically
# "busy (no program)", a live terminal whose foreground has no argv yet — the guard does the same
# job itself with `hc send` on the entry's own terminal, waits for pi to appear, and only then
# logs a resume; it never types twice in one boot (restored_boot_id, or state/resumed).
#
# A live pi tab is never touched, one repair a minute per tab keeps a pi that exits at once from
# becoming a spawn loop, every repair is logged with the path it took (resumed terminal tN vs
# opened a new pi), and the person's space and tab are put back afterwards.
#
# This guard only ever looks for, creates, selects and repairs the space named big-boss-pi.
# A space named pi-master belongs to the old workspace: it is never touched from here.
#
# Radar Vol. 35: blip 20 (stateful guardrails) — a rule nothing checks is a rule that is gone.
set -uo pipefail

self_root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
ROOT=${PI_BOSS_ROOT:-${PI_MASTER_ROOT:-$self_root}}
SPACE_NAME=${PI_BOSS_SPACE:-big-boss-pi}
STATE=$ROOT/state
LOG=$STATE/guard.log
SPACE_STATE=$STATE/space.json
REPAIRS=$STATE/repairs
# Terminals this guard resumed in this boot, one "<boot id> <terminal>" per line. The entry is
# owned by ~/.pi and is not ours to rewrite, so the guard keeps its own half of "never type twice".
RESUMED=$STATE/resumed
# The kernel's boot id, so a resume is never repeated inside one boot by a restarted guard.
BOOT=$(tr -d '\n' </proc/sys/kernel/random/boot_id 2>/dev/null || true)
# The resume map and its script live in ~/.pi. Both are overridable so a test can supply a fake
# map and a fake script instead of a desktop app and a real session.
RESUME_SCRIPT=${PI_BOSS_RESUME_SCRIPT:-${HOME:-}/.pi/scripts/herdr-resume.sh}
RESUME_FALLBACK=${HOME:-}/.pi/scripts/herdr-resume.mjs
RESUME_DIR=${PI_BOSS_RESUME_DIR:-${PI_HERDR_RESUME_DIR:-${HOME:-}/.pi/agent/herdr-resume}}
RESUME_TIMEOUT=${PI_BOSS_RESUME_TIMEOUT:-45}
INTERVAL=${PI_BOSS_GUARD_INTERVAL:-${PI_MASTER_GUARD_INTERVAL:-5}}
# A tab is opened again at most once a minute, so a pi that dies on start is one repair a
# minute and not five a second.
REPAIR_EVERY=60
KICKOFF="Read AGENTS.md in this workspace. You are the big-boss-pi agent: you delegate, you do not do project work."

mkdir -p "$STATE"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# Keep the log from growing without bound during a long session.
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 200000 ]; then
	tail -n 500 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

need_app() { command -v herdr-app >/dev/null 2>&1; }

# field <path> — read stdout as JSON and print one dotted field, or nothing.
field() {
	node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{}
			const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],j);
			if(v!==undefined&&v!==null)process.stdout.write(String(v))})' "$1"
}

# space_id — from a `herdr-app ls` snapshot on stdin, print this space's id, or nothing.
space_id() {
	SPACE_NAME=$SPACE_NAME node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			const hit=(j.spaces||[]).find(s=>s.name===process.env.SPACE_NAME);
			if(hit)process.stdout.write(hit.id);
		})'
}

known_space() {
	[ -f "$SPACE_STATE" ] || return 0
	node -e '
		const fs=require("fs");try{const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));if(j.space)process.stdout.write(j.space)}catch{}' "$SPACE_STATE"
}

# pi_argv <1 for the boss tab> — the argv a replacement tab starts. Always absolute: the
# holder restarts this command later from a PATH without the pnpm bin dir.
pi_argv() {
	node -e 'const [p,a]=process.argv.slice(1);
		process.stdout.write(JSON.stringify(["sh","-lc","exec "+p+(a==="1"?" -a":"")]))' \
		"$ROOT/bin/pi-bare" "$1"
}

create_space() {
	local out argv
	argv=$(pi_argv 1)
	out=$(herdr-app do space.new --name "$SPACE_NAME" --folder "$ROOT" --tab master \
		--argv "$argv" --task "$KICKOFF" 2>&1) || {
		log "space.new failed: $out"
		return 1
	}
	local space terminal
	space=$(printf '%s' "$out" | field space); [ -n "$space" ] || space=$(printf '%s' "$out" | field id)
	[ -n "$space" ] || space=$(printf '%s' "$out" | field result.space)
	terminal=$(printf '%s' "$out" | field terminal)
	[ -n "$terminal" ] || terminal=$(printf '%s' "$out" | field result.terminal)
	[ -n "$space" ] || { log "could not read the new space id: $out"; return 1; }
	printf '{"space":"%s","terminal":"%s","created":"%s"}\n' "$space" "$terminal" "$(date -Iseconds)" >"$SPACE_STATE"
	log "created $SPACE_NAME ($space, terminal \`$terminal\`)"

	# --task can arrive before pi listens; send it again once pi has had time to boot.
	if [ -n "$terminal" ] && command -v hc >/dev/null 2>&1; then
		sleep 12
		if hc send "$terminal" "$KICKOFF" >/dev/null 2>&1; then
			log "kickoff sent to $terminal"
		else
			log "could not send the kickoff message to $terminal"
		fi
	else
		log "no terminal id from space.new; the agent starts without a kickoff message"
	fi
}

# --- repairing tabs whose agent is gone -------------------------------------

# screen_state — the "space tab" the person is looking at, or empty when it cannot be read.
screen_state() {
	local out space tab
	out=$(herdr-app status 2>/dev/null) || return 0
	space=$(printf '%s' "$out" | field space)
	tab=$(printf '%s' "$out" | field tab)
	[ -n "$space" ] && [ -n "$tab" ] || return 0
	printf '%s %s' "$space" "$tab"
}

# restore_focus <space> <tab> — select that space, then that tab, by id. Never fatal.
restore_focus() {
	herdr-app do space.select --id "$1" >/dev/null 2>&1 || return 1
	herdr-app do tab.select --id "$2" >/dev/null 2>&1 || return 1
	return 0
}

# stale_tabs <space id> — from a `herdr-app ls` snapshot on stdin, print
# "tab<TAB>name<TAB>index<TAB>terminal" for every tab of that space whose terminals are all
# something other than pi. The terminal id is the key the resume map is written under
# (agent/extensions/herdr-resume-map.ts), so the repair has to carry it. A tab with no terminal
# is a mod, not a lost agent. A tab that still holds a live pi is left alone.
stale_tabs() {
	SPACE_ID=$1 node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(0)}
			const sp=(j.spaces||[]).find(s=>s.id===process.env.SPACE_ID);
			if(!sp)process.exit(0);
			(sp.tabs||[]).forEach((t,i)=>{
				const ts=t.terminals||[];
				if(!ts.length)return;
				if(ts.some(x=>x&&x.app==="pi"))return;
				const terminal=ts[0]&&ts[0].id?ts[0].id:"";
				process.stdout.write([t.id,t.name===null||t.name===undefined?"":t.name,i+1,terminal].join("\t")+"\n");
			});
		})'
}

# tab_holds_pi <space> <tab> — true when one of that tab's terminals is pi again, read from a
# fresh `herdr-app ls` snapshot on stdin. What a resume is worth is what the app reports, not
# what the resume script printed.
tab_holds_pi() {
	SPACE_ID=$1 TAB_ID=$2 node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			const sp=(j.spaces||[]).find(s=>s.id===process.env.SPACE_ID);
			if(!sp)process.exit(1);
			const hit=(sp.tabs||[]).find(t=>t.id===process.env.TAB_ID);
			if(!hit)process.exit(1);
			process.exit((hit.terminals||[]).some(x=>x&&x.app==="pi")?0:1);
		})'
}

# entry_field <file> <dotted path> — one field of a resume entry, or nothing.
entry_field() { field "$2" <"$1" 2>/dev/null; }

# entry_argv <file> — the entry's launch argv as a JSON array, or nothing when it has none.
entry_argv() {
	node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{}
			if(!Array.isArray(j.argv)||!j.argv.length)process.exit(1);
			process.stdout.write(JSON.stringify(j.argv))})' <"$1" 2>/dev/null
}

# resume_entry_for_tab <space> <tab> <terminal> — the newest usable resume entry for this tab, or
# nothing. Matched by terminal id, or by the tab id (and space, when the entry has one) the entry
# recorded: after a host reboot herdr-app reports no terminal id for a parked tab, so the tab id
# in the entry is the only key left. A tab with several entries takes the newest `updated_at`; an
# entry whose session file is gone is not usable, because there is nothing to resume.
resume_entry_for_tab() {
	local space=$1 tab=$2 terminal=${3:-}
	[ -d "$RESUME_DIR" ] || return 1
	SPACE_ID=$space TAB_ID=$tab TERMINAL_ID=$terminal DIR=$RESUME_DIR node -e '
		const fs=require("fs"),path=require("path");
		const {SPACE_ID,TAB_ID,TERMINAL_ID,DIR}=process.env;
		let names=[];try{names=fs.readdirSync(DIR).filter(n=>n.endsWith(".json"))}catch{process.exit(1)}
		const hits=[];
		for(const n of names){
			let e;try{e=JSON.parse(fs.readFileSync(path.join(DIR,n),"utf8"))}catch{continue}
			if(typeof e.session_path!=="string"||!e.session_path)continue;
			if(!fs.existsSync(e.session_path))continue;
			if(!Array.isArray(e.argv)||!e.argv.length)continue;
			const byTerminal=TERMINAL_ID&&e.terminal===TERMINAL_ID;
			const byTab=TAB_ID&&e.tab===TAB_ID&&(!e.space||!SPACE_ID||e.space===SPACE_ID);
			if(!byTerminal&&!byTab)continue;
			hits.push({p:path.join(DIR,n),u:String(e.updated_at||"")});
		}
		if(!hits.length)process.exit(1);
		hits.sort((a,b)=>a.u<b.u?1:a.u>b.u?-1:0);
		process.stdout.write(hits[0].p);'
}

# hc_json <terminal> — `hc get <terminal> --json`, or nothing when hc is absent or lost it.
hc_json() {
	command -v hc >/dev/null 2>&1 || return 1
	[ -n "$1" ] || return 1
	hc get "$1" --json 2>/dev/null
}

# terminal_state <terminal> — what is in that terminal right now, one word:
#   attached   a shell (or nothing yet) is there: a typed `exec` line will run;
#   unattached a live terminal whose foreground has no argv yet — not busy, just not reported;
#   busy:<cmd> something that is not a shell runs there: never type over a person or a pi;
#   unknown    hc is absent, or does not know the terminal.
terminal_state() {
	local facts
	facts=$(hc_json "$1") || { printf 'unknown'; return 0; }
	[ -n "$facts" ] || { printf 'unknown'; return 0; }
	printf '%s' "$facts" | node -e '
		const SHELLS=new Set(["sh","bash","zsh","dash","ksh","fish","nu","pwsh","powershell","elvish","xonsh"]);
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.stdout.write("unknown");return}
			if(j.state!=="live")return process.stdout.write("unknown");
			const argv=j.foreground&&j.foreground.argv;
			if(!Array.isArray(argv)||!argv.length)return process.stdout.write("unattached");
			const base=String(argv[0]).split("/").pop().toLowerCase().replace(/\.exe$/,"");
			if(SHELLS.has(base))return process.stdout.write("attached");
			process.stdout.write("busy:"+argv.join(" "));
		})'
}

# terminal_runs_pi <terminal> — true when hc reports a live program that is not a shell there.
terminal_runs_pi() {
	local state
	state=$(terminal_state "$1")
	case $state in
	attached | unattached | unknown | "") return 1 ;;
	esac
	return 0
}

# wait_attached <terminal> — the terminal herdr-core keeps takes a moment to get its shell, and a
# live terminal whose foreground has no argv yet is *not attached*, not busy: today's lost resume
# was exactly that reading. Wait for an answer within the bound, and a terminal that still has no
# foreground after the bound is treated as the recovered shell it is.
wait_attached() {
	local terminal=$1 tries=${PI_BOSS_ATTACH_TRIES:-4} gap=${PI_BOSS_ATTACH_GAP:-1} state i
	for ((i = 0; i < tries; i++)); do
		state=$(terminal_state "$terminal")
		case $state in
		attached | busy:*) printf '%s' "$state"; return 0 ;;
		unknown) printf 'unknown'; return 0 ;;
		esac
		[ "$i" -lt $((tries - 1)) ] && sleep "$gap"
	done
	printf 'attached'
}

# resumed_this_boot <terminal> / mark_resumed <terminal> — the guard's own "typed once" ledger.
resumed_this_boot() {
	[ -f "$RESUMED" ] || return 1
	awk -v b="$BOOT" -v t="$1" '$1==b && $2==t{f=1} END{exit !f}' "$RESUMED"
}

mark_resumed() {
	printf '%s %s\n' "$BOOT" "$1" >>"$RESUMED"
}

# exec_line <argv json> <session path> — the shell line the resume script would type.
exec_line() {
	ARGV=$1 SESSION=$2 node -e '
		const q=w=>/^[A-Za-z0-9_@%+=:,./-]+$/.test(w)?w:"'\''"+String(w).replace(/'"'"'/g,"'"'"'\\'"'"''"'"'")+"'\''";
		const words=[...JSON.parse(process.env.ARGV),"--session",process.env.SESSION];
		process.stdout.write("exec "+words.map(q).join(" "))'
}

# tab_has_pi <space> <tab> — what herdr-app says, from a fresh snapshot.
tab_has_pi() { herdr-app ls 2>/dev/null | tab_holds_pi "$1" "$2"; }

# resume_via_entry <entry> <space> <tab> <name> — do the script's job here, on the entry's own
# terminal: `hc send` the same exec line into the recovered shell, then wait for pi. Used when
# herdr-resume.mjs declined, and when herdr-app has no terminal for the tab but hc knows the one
# the entry recorded. Returns 0 when pi is running in the tab afterwards, 2 when this boot already
# restored that session (nothing to do, and typing again would be a second pi), 1 otherwise.
resume_via_entry() {
	local entry=$1 space=$2 tab=$3 name=$4 terminal session argv line state i
	terminal=$(entry_field "$entry" terminal)
	session=$(entry_field "$entry" session_path)
	argv=$(entry_argv "$entry") || { log "tab $name ($tab) has an entry $entry with no launch argv; not resuming"; return 1; }
	[ -n "$terminal" ] && [ -n "$session" ] || { log "tab $name ($tab) entry $entry has no terminal or session path; not resuming"; return 1; }
		if [ -n "$BOOT" ] && [ "$(entry_field "$entry" restored_boot_id)" = "$BOOT" ]; then
		log "tab $name ($tab) was already resumed in this boot (entry $entry); not typing a second time"
		return 2
	fi
	if resumed_this_boot "$terminal"; then
		log "terminal \`$terminal\` in tab $name ($tab) was already resumed in this boot; not typing a second time"
		return 2
	fi
	state=$(wait_attached "$terminal")
	case $state in
	busy:*)
		log "could not resume terminal \`$terminal\` in tab $name ($tab): something else is running there (${state#busy:}); not typing over it"
		return 1
		;;
	unknown)
		log "could not resume terminal \`$terminal\` in tab $name ($tab): hc does not know that terminal"
		return 1
		;;
	esac
	command -v hc >/dev/null 2>&1 || { log "could not resume terminal \`$terminal\` in tab $name ($tab): hc is not on PATH"; return 1; }
	line=$(exec_line "$argv" "$session")
	if ! hc send "$terminal" "$line" >/dev/null 2>&1; then
		log "could not resume terminal \`$terminal\` in tab $name ($tab): hc send failed"
		return 1
	fi
	mark_resumed "$terminal"
	for ((i = 0; i < ${PI_BOSS_RESUME_START_WAIT:-10}; i++)); do
		if tab_has_pi "$space" "$tab" || terminal_runs_pi "$terminal"; then
			log "resumed terminal \`$terminal\` in tab $name ($tab) with hc from $entry ($line); the tab keeps its session, nothing was opened or closed"
			return 0
		fi
		sleep 1
	done
	log "typed the session into terminal \`$terminal\` in tab $name ($tab) but pi did not start; pi is not running there"
	return 1
}

# resume_entries — run ~/.pi's resume script for every entry it has. The script already decides
# per terminal: it skips a busy terminal, a terminal whose pi exited on its own, a session file
# that is gone, and an entry it restored in this boot, and it never starts a second pi. The waits
# are shortened so a repair cannot stall the poll, and the whole call is bounded.
resume_entries() {
	local script=$RESUME_SCRIPT runner
	[ -f "$script" ] || script=$RESUME_FALLBACK
	[ -f "$script" ] || { printf 'no resume script at %s or %s' "$RESUME_SCRIPT" "$RESUME_FALLBACK"; return 1; }
	if [ -x "$script" ]; then
		runner=$script
	else
		command -v node >/dev/null 2>&1 || { printf 'node not found; cannot run %s' "$script"; return 1; }
		runner=node
	fi
	if ! command -v timeout >/dev/null 2>&1; then
		# Without timeout the script's own waits still bound it: a few seconds per entry.
		RESUME_TIMEOUT=0
	fi
	if [ "$RESUME_TIMEOUT" = 0 ]; then
		env PI_HERDR_RESUME_WAIT_MS="${PI_HERDR_RESUME_WAIT_MS:-5000}" \
			PI_HERDR_RESUME_ENTRY_MS="${PI_HERDR_RESUME_ENTRY_MS:-3000}" \
			PI_HERDR_RESUME_START_MS="${PI_HERDR_RESUME_START_MS:-8000}" \
			PI_HERDR_RESUME_DIR="$RESUME_DIR" \
			"$runner" "$script" 2>&1
		return 0
	fi
	env PI_HERDR_RESUME_WAIT_MS="${PI_HERDR_RESUME_WAIT_MS:-5000}" \
		PI_HERDR_RESUME_ENTRY_MS="${PI_HERDR_RESUME_ENTRY_MS:-3000}" \
		PI_HERDR_RESUME_START_MS="${PI_HERDR_RESUME_START_MS:-8000}" \
		PI_HERDR_RESUME_DIR="$RESUME_DIR" \
		timeout "$RESUME_TIMEOUT" "$runner" "$script" 2>&1
}

# repair_key <space id> <name> <index> — what the rate limit is counted on. The tab id changes
# with every repair, so counting on it would let a broken pi be reopened every poll; the tab's
# name and place survive, so the minute is counted there.
repair_key() { printf '%s:%s:%s' "$1" "${2// /_}" "$3"; }

repaired_recently() {
	[ -f "$REPAIRS" ] || return 1
	awk -v k="$1" -v c="$(($(date +%s) - REPAIR_EVERY))" \
		'$1==k && $2>=c {found=1} END{exit !found}' "$REPAIRS"
}

mark_repaired() {
	printf '%s %s\n' "$1" "$(date +%s)" >>"$REPAIRS"
	if [ "$(wc -l <"$REPAIRS" 2>/dev/null || echo 0)" -gt 200 ]; then
		tail -n 200 "$REPAIRS" >"$REPAIRS.tmp" && mv "$REPAIRS.tmp" "$REPAIRS"
	fi
}

# kickoff_later <terminal> — send the first message once pi has had time to boot, off the loop.
kickoff_later() {
	(
		sleep 12
		if hc send "$1" "$KICKOFF" >/dev/null 2>&1; then
			log "kickoff sent to $1"
		else
			log "could not send the kickoff message to $1"
		fi
	) &
}

# repair_tab <space> <tab> <name> <index> <terminal> — returns 0 only when it repaired the tab.
# Two paths, in this order:
#   1. the tab has a resume entry, by its terminal id or by the tab id in the entry — let the
#      ~/.pi resume script run, then, when that declined, do the same job here with `hc send` on
#      the entry's terminal. Either way the end state is pi running on the recorded session, and
#      nothing is opened or closed;
#   2. no usable entry, or the resume did not put pi back — open the replacement first and close
#      the stale tab after: closing a space's only tab would end the space, and a failed open leaves
#      the person with what they had. Same name, same place, and an absolute argv so the holder
#      can restart it. The boss tab (master) gets the kickoff message again.
repair_tab() {
	local space=$1 tab=$2 name=$3 index=$4 terminal=${5:-} boss=0 argv out new_terminal args=() key entry
	key=$(repair_key "$space" "$name" "$index")
	repaired_recently "$key" && return 1
	[ "$name" = master ] && boss=1

	if entry=$(resume_entry_for_tab "$space" "$tab" "$terminal"); then
		local resumed entry_terminal
		entry_terminal=$(entry_field "$entry" terminal)
		resumed=$(resume_entries)
		mark_repaired "$key"
		# The script is the component that knows a recovered shell; then the guard checks itself,
		# by what herdr-app says about the tab and by what hc says about the entry's terminal, so a
		# pi the script did start is never typed over.
		if tab_has_pi "$space" "$tab" || terminal_runs_pi "$entry_terminal"; then
			log "resumed terminal \`$entry_terminal\` in tab $name ($tab) from $entry; the tab keeps its session, nothing was opened or closed"
			return 0
		fi
		# Declined — often "busy (no program)" on a live terminal that has no argv yet. Do it here.
		resume_via_entry "$entry" "$space" "$tab" "$name"
		case $? in
		0) return 0 ;;
		2)
			# Already restored in this boot and pi is gone: the person let it go. Leave the tab be.
			log "tab $name ($tab) already had its session resumed in this boot; leaving it alone"
			return 1
			;;
		esac
		log "could not resume terminal \`$entry_terminal\` in tab $name ($tab); opening a new pi instead: $(printf '%s' "$resumed" | tail -n 2 | tr '\n' ' ')"
	else
		log "tab $name ($tab) opened fresh: terminal \`${terminal:-unknown}\` has no entry in $RESUME_DIR, so it never held pi"
	fi

	argv=$(pi_argv "$boss")
	[ -n "$name" ] && args+=(--name "$name")
	out=$(herdr-app do tab.new --space "$space" "${args[@]}" --folder "$ROOT" --argv "$argv" 2>&1)
	new_terminal=$(printf '%s' "$out" | field terminal)
	[ -n "$new_terminal" ] || new_terminal=$(printf '%s' "$out" | field result.terminal)
	if [ -z "$new_terminal" ]; then
		log "could not open a replacement for the stale tab $name ($tab): $out"
		return 1
	fi
	mark_repaired "$key"
	log "opened a new pi in tab $name ($tab -> terminal \`$new_terminal\`) with $argv"
	out=$(herdr-app do tab.close --id "$tab" --confirmed true 2>&1) ||
		log "could not close the stale tab $name ($tab); it is still open beside \`$new_terminal\`: $out"
	herdr-app do tab.move --id "$new_terminal" --index "$index" >/dev/null 2>&1
	[ "$boss" = 1 ] && command -v hc >/dev/null 2>&1 && kickoff_later "$new_terminal"
	return 0
}

# repair_stale_tabs <space id> — repair every stale tab of the space, then put the person back
# on the space and tab they were looking at. A failed restore is one line, never a failed repair.
repair_stale_tabs() {
	local space=$1 snapshot=$2 stale tab name index before touched=0
	stale=$(printf '%s' "$snapshot" | stale_tabs "$space") || return 0
	[ -n "$stale" ] || return 0
	before=$(screen_state)
	while IFS=$'\t' read -r tab name index terminal; do
		[ -n "$tab" ] || continue
		repair_tab "$space" "$tab" "$name" "$index" "$terminal" && touched=1
	done <<<"$stale"
	[ "$touched" = 1 ] || return 0
	if [ -n "$before" ]; then
		restore_focus ${before} ||
			printf 'guard: could not restore focus to space %s tab %s after repairing %s\n' \
				"${before%% *}" "${before##* }" "$SPACE_NAME" >&2
	fi
	return 0
}

ensure() {
	local snapshot space
	snapshot=$(herdr-app ls 2>/dev/null) || snapshot=""
	space=$(printf '%s' "$snapshot" | space_id) || {
		# Log the transition, not every poll: a closed window is normal.
		[ "$app_down" = 1 ] || log "herdr-app not answering; waiting"
		app_down=1
		return 0
	}
	# Herdr (re)started: put the person on big-boss-pi once, then never steal focus again.
	if [ "$app_down" = 1 ]; then
		log "herdr-app answered again"
		app_down=0
		herdr-app do space.select --id "$space" >/dev/null 2>&1 && log "selected $SPACE_NAME ($space)"
	fi
	if [ -z "$space" ]; then
		create_space
		return 0
	fi
	local known
	known=$(known_space)
	if [ "$space" != "$known" ]; then
		printf '{"space":"%s","created":"%s"}\n' "$space" "$(date -Iseconds)" >"$SPACE_STATE"
	fi
	repair_stale_tabs "$space" "$snapshot"
	if [ "$1" = "select" ]; then
		herdr-app do space.select --id "$space" >/dev/null 2>&1 && log "selected $SPACE_NAME ($space)"
	fi
}

# Dispatch only when executed: sourcing this file just gives you the functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	# The old workspace's space is not ours to keep alive, repair, or select.
	if [ "$SPACE_NAME" = pi-master ]; then
		printf 'guard: refusing to guard a space named pi-master\n' >&2
		exit 0
	fi
	need_app || { log "herdr-app not on PATH; exiting"; exit 0; }
	log "guard started (space $SPACE_NAME, root $ROOT, interval ${INTERVAL}s)"
	app_down=0

	# Recreate immediately, and put the person on it: that is "open when Herdr starts".
	ensure select

	# One poll and out: a test drives a repair without waiting for the interval, and a person can
	# ask for one repair without starting a service.
	[ "${PI_BOSS_ONCE:-0}" = 1 ] && exit 0

	while sleep "$INTERVAL"; do
		ensure ""
	done
fi
