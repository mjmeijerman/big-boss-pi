#!/usr/bin/env bash
# guard — keeps the big-boss-pi space alive.
#
# Herdr has no per-space lock: space.close ends a space and its terminals, and no hook lets a
# mod veto it. So the space is made self-healing instead. Every few seconds: is there a space
# named big-boss-pi? If not, rebuild it with a fresh big-boss-pi agent. The first time Herdr
# answers after this service starts, select it, so Herdr opens on big-boss-pi.
#
# herdr-core parks kept terminals and gives them a shell on the next start, so a restart leaves
# the space with its tabs ("master", "Pi (bare)") and no agents in them: tabs that say Pi over
# a prompt. ensure() repairs those.
#
# A repair prefers the session that was there. Every hc terminal that ran pi has a resume entry in
# ~/.pi/agent/herdr-resume/<terminal>.json (agent/extensions/herdr-resume-map.ts), and
# ~/.pi/scripts/herdr-resume.mjs knows how to type `exec <argv> --session <path>` back into the
# recovered shell. So a stale tab with an entry is resumed — same conversation, same tab — and only
# a tab that never held pi (no entry) is closed and opened again with an absolute argv, so the core
# can restart it later: the holder's PATH has no pnpm bin dir, so a bare `pi-bare` cannot be
# restarted. A resume that does not end with pi running falls back to that same reopen.
#
# The entry is looked up by terminal id **or** by the tab id the entry recorded: after a host
# reboot herdr-app reports no terminal for a parked tab, so a terminal-only lookup sees nothing
# and reopens the tab fresh over a conversation that is still on disk. The newest entry wins and
# its session file has to exist. And when herdr-resume.mjs declines a terminal — typically
# "busy (no program)", a live terminal whose foreground has no argv yet — the guard does the same
# job itself with `hc send` on the entry's own terminal, waits for pi to appear, and only then
# logs a resume; it never types twice in one boot (restored_boot_id, or state/resumed).
#
# Whose tab is it? herdr-core hands the space back with a shell in every parked tab, so "a tab with
# no pi" is not the same thing as "a tab to repair". A tab is a repair candidate only when it was
# parked when the guard started, when it carries a resume entry, or when this guard opened it
# itself. A tab the person opened while the guard runs belongs to the person: no pi in it, no
# close, no rename — unless it carries a resume entry, because then it did hold pi and there is a
# conversation to put back. That classification is kept in $STATE/tab-classes so a guard restart does not
# reread the person's tab as a parked one. A parked tab whose terminal now holds an interactive
# shell the guard did not start is the person's too: it is left alone and the log says so.
#
# A live pi tab is never touched, one repair a minute per tab keeps a pi that exits at once from
# becoming a spawn loop, every repair is logged with the path it took (resumed terminal tN vs
# opened a new pi), and the person's space and tab are put back afterwards.
#
# The resume line is only for a terminal that shows a shell prompt. `hc` answers `unattached` for a
# live terminal whose foreground has no argv yet, and a pi that is still starting looks exactly
# like a recovered shell in that reading — so `wait_attached` reports only states it actually saw,
# and `resume_via_entry` refuses to type when the last look says no prompt, or says the tab already
# runs pi (by `herdr-app ls`, or by an argv that carries this very session). A tab left alone for
# either reason is not reopened: it is a pi, not a dead tab.
#
# This guard only ever looks for, creates, selects and repairs the space named big-boss-pi.
# A space named pi-master belongs to the old workspace: it is never touched from here.
#
# Radar Vol. 35: blip 20 (stateful guardrails) — a rule nothing checks is a rule that is gone.
#
# Path spelling on Windows. Under Git Bash this script's own root is an MSYS path
# (/c/Users/<you>/big-boss-pi): bash, awk, coreutils and the resume script all take it as it is, and
# MSYS rewrites a path-like argv on its way to a native program. Two boundaries no rewrite reaches:
# a path carried *inside* a JSON string (the `--argv` handed to herdr-app), and a path carried in an
# environment variable or argv to node.exe, which is a native program and would read /c/... off the
# current drive. So the boundary is explicit instead of guessed:
#   * $ROOT stays in the MSYS spelling — that is what the shell and the tab's `sh -lc` line need;
#   * native_path() is the spelling a native Windows program can read, and is used at every
#     boundary that leaves the script: --folder, and every path handed to node;
#   * on Linux and macOS both are the identity, so nothing about that platform changes.
# native_path uses `cygpath -m` (C:/Users/<you>/...) and not -w: slash-separated is still an
# absolute native path that Windows APIs accept, and it needs no escaping inside the JSON argv or
# the shell line a tab runs.
set -uo pipefail

# win — is this shell the Git Bash / MSYS one? MSYS sets MSYSTEM, Cygwin sets OSTYPE, and
# PI_PLATFORM=win32 is how a test says the same thing without a Windows host.
win=0
case ${PI_PLATFORM:-$(uname -s 2>/dev/null)} in
win32 | win64 | windows* | *MINGW* | *MSYS* | *CYGWIN* | cygwin | msys*) win=1 ;;
esac
[ "$win" = 0 ] && [ -n "${MSYSTEM:-}" ] && win=1

posix_path() { # the MSYS spelling of a path, even when a native one was passed in
	local p=${1:-}
	if [ "$win" = 1 ] && command -v cygpath >/dev/null 2>&1; then
		cygpath -u "$p" 2>/dev/null || printf '%s' "$p"
	else
		printf '%s' "$p"
	fi
}

native_path() { # the spelling a native Windows program can read
	local p=${1:-}
	if [ "$win" = 1 ] && command -v cygpath >/dev/null 2>&1; then
		cygpath -m "$p" 2>/dev/null || printf '%s' "$p"
	else
		printf '%s' "$p"
	fi
}

# shq <word> — one single-quoted word for sh: a path with a space survives as one word.
shq() { printf "'%s'" "$(printf '%s' "${1:-}" | sed "s/'/'\\\\''/g")"; }

# shell_argv0 — the program a tab's `-lc` line runs. The app that spawns a tab does not inherit this
# shell's PATH: on Windows `sh` may not resolve there at all, and a tab that cannot start its shell
# is a space with nothing in it. So Windows gets the absolute native path of the sh this guard found
# (C:/Program Files/Git/usr/bin/sh — spaces are the app's problem, not the JSON's). Elsewhere `sh`
# stays a bare word, exactly as before.
shell_argv0() {
	local s
	if [ "$win" = 1 ]; then
		s=$(command -v sh 2>/dev/null || true)
		[ -n "$s" ] && {
			native_path "$s"
			return 0
		}
	fi
	printf 'sh'
}

self_root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
ROOT=$(posix_path "${PI_BOSS_ROOT:-${PI_MASTER_ROOT:-$self_root}}")
# Computed once: the native spelling every boundary uses, so there is one place to get it right.
ROOT_NATIVE=$(native_path "$ROOT")
SPACE_NAME=${PI_BOSS_SPACE:-big-boss-pi}
STATE=$ROOT/state
LOG=$STATE/guard.log
SPACE_STATE=$STATE/space.json
REPAIRS=$STATE/repairs
# The created stamps the guard writes. Nothing reads them back, so `date -Iseconds` is not needed
# for correctness — this keeps the JSON well formed wherever the coreutils are older.
iso_now() { date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S'; }
# Which tab belongs to whom, one "<space> <tab> parked|guard|person>" per line, and the marker that
# says the first snapshot after this guard started has already been read as the parked tabs.
TAB_CLASSES=$STATE/tab-classes
TAB_SEED=$STATE/tab-classes-seeded
# Terminals a `tab.new` answered with, kept until a snapshot shows the tab they landed in: `ls` can
# lag the new tab, and a tab nobody classified is the person's — a pi that dies in the guard's own
# replacement would then never come back.
TAB_PENDING=$STATE/guard-terminals
# Terminals this guard resumed in this boot, one "<boot id> <terminal>" per line. The entry is
# owned by ~/.pi and is not ours to rewrite, so the guard keeps its own half of "never type twice".
RESUMED=$STATE/resumed
# The boot id, so a resume is never repeated inside one boot by a restarted guard. Windows has no
# /proc; there the boot instant comes from node (already a hard dependency): uptime is measured from
# boot, so `Date.now() - uptime` is when the machine booted. Rounded to the minute, a second of
# drift between two calls does not change the key, and a reboot does.
BOOT_ID_FILE=${PI_BOSS_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
boot_id() {
	local b=""
	[ -r "$BOOT_ID_FILE" ] && b=$(tr -d '\n' <"$BOOT_ID_FILE" 2>/dev/null || true)
	[ -n "$b" ] && {
		printf '%s' "$b"
		return 0
	}
	command -v node >/dev/null 2>&1 || return 0
	node -e 'const os=require("os");
		process.stdout.write("boot"+Math.round((Date.now()-os.uptime()*1000)/60000))' 2>/dev/null || true
}
BOOT=$(boot_id)
# Did herdr-app answer on the last pass? A file, not a shell variable: every pass after the first
# runs in a subshell, so a fatal error in one pass ends that pass and not the guard, and the next
# pass still has to know that Herdr restarted (that is the one moment the space is selected).
APP_DOWN=$STATE/app-down
app_down() { [ -f "$APP_DOWN" ]; }
set_app_down() { if [ "$1" = 1 ]; then : >"$APP_DOWN"; else rm -f "$APP_DOWN"; fi; }
# The resume map and its script live in ~/.pi. Both are overridable so a test can supply a fake
# map and a fake script instead of a desktop app and a real session.
RESUME_SCRIPT=${PI_BOSS_RESUME_SCRIPT:-${HOME:-}/.pi/scripts/herdr-resume.sh}
RESUME_FALLBACK=${HOME:-}/.pi/scripts/herdr-resume.mjs
RESUME_DIR=${PI_BOSS_RESUME_DIR:-${PI_HERDR_RESUME_DIR:-${HOME:-}/.pi/agent/herdr-resume}}
RESUME_TIMEOUT=${PI_BOSS_RESUME_TIMEOUT:-45}
INTERVAL=${PI_BOSS_GUARD_INTERVAL:-${PI_MASTER_GUARD_INTERVAL:-5}}
# A tab is opened again at most once a minute, so a pi that dies on start is one repair a
# minute and not five a second.
REPAIR_EVERY=60
KICKOFF="Read AGENTS.md in this workspace. You are the big-boss-pi agent: you delegate, you do not do project work."
# How long --task gets before it is sent again, so a test does not pay 12 seconds to prove a kickoff.
KICKOFF_WAIT=${PI_BOSS_KICKOFF_WAIT:-12}

mkdir -p "$STATE"

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

# Keep the log from growing without bound during a long session.
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 200000 ]; then
	tail -n 500 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

need_app() { command -v herdr-app >/dev/null 2>&1; }

# field <path> — read stdout as JSON and print one dotted field, or nothing.
field() {
	node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{}
			const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],j);
			if(v!==undefined&&v!==null)process.stdout.write(String(v))})' "$1"
}

# space_id — from a `herdr-app ls` snapshot on stdin, print this space's id, or nothing.
space_id() {
	SPACE_NAME=$SPACE_NAME node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			const hit=(j.spaces||[]).find(s=>s.name===process.env.SPACE_NAME);
			if(hit)process.stdout.write(hit.id);
		})'
}

known_space() {
	[ -f "$SPACE_STATE" ] || return 0
	node -e '
		const fs=require("fs");try{const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));if(j.space)process.stdout.write(j.space)}catch{}' "$(native_path "$SPACE_STATE")"
}

# pi_argv <1 for the boss tab> — the argv a replacement tab starts. Always absolute: the
# holder restarts this command later from a PATH without the pnpm bin dir. The exec target is the
# MSYS path, because the shell that runs this line is Git Bash on Windows and sh elsewhere, and it
# is one single-quoted word so a root with a space in it still arrives as one argument.
pi_argv() {
	local exe line
	exe=$(shq "$ROOT/bin/pi-bare")
	line="exec $exe"
	[ "$1" = 1 ] && line="$line -a"
	node -e 'process.stdout.write(JSON.stringify(process.argv.slice(1)))' \
		"$(shell_argv0)" "-lc" "$line"
}

create_space() {
	local out argv
	argv=$(pi_argv 1)
	out=$(herdr-app do space.new --name "$SPACE_NAME" --folder "$ROOT_NATIVE" --tab master \
		--argv "$argv" --task "$KICKOFF" 2>&1) || {
		log "space.new failed: $out"
		return 1
	}
	local space terminal
	space=$(printf '%s' "$out" | field space); [ -n "$space" ] || space=$(printf '%s' "$out" | field id)
	[ -n "$space" ] || space=$(printf '%s' "$out" | field result.space)
	terminal=$(printf '%s' "$out" | field terminal)
	[ -n "$terminal" ] || terminal=$(printf '%s' "$out" | field result.terminal)
	[ -n "$space" ] || { log "could not read the new space id: $out"; return 1; }
	printf '{"space":"%s","terminal":"%s","created":"%s"}\n' "$space" "$terminal" "$(iso_now)" >"$SPACE_STATE"
	log "created $SPACE_NAME ($space, terminal \`$terminal\`)"

	# --task can arrive before pi listens; send it again once pi has had time to boot. A missing hc
	# is not a failure: the space exists, and the space is what this guard is for.
	if [ -z "$terminal" ]; then
		log "no terminal id from space.new; the agent starts without a kickoff message"
	elif ! command -v hc >/dev/null 2>&1; then
		log "hc is not on PATH; the kickoff goes in with --task only"
	else
		sleep "$KICKOFF_WAIT"
		if hc send "$terminal" "$KICKOFF" >/dev/null 2>&1; then
			log "kickoff sent to $terminal"
		else
			log "could not send the kickoff message to $terminal"
		fi
	fi
}

# --- repairing tabs whose agent is gone -------------------------------------

# screen_state — the "space tab" the person is looking at, or empty when it cannot be read.
screen_state() {
	local out space tab
	out=$(herdr-app status 2>/dev/null) || return 0
	space=$(printf '%s' "$out" | field space)
	tab=$(printf '%s' "$out" | field tab)
	[ -n "$space" ] && [ -n "$tab" ] || return 0
	printf '%s %s' "$space" "$tab"
}

# restore_focus <space> <tab> — select that space, then that tab, by id. Never fatal.
restore_focus() {
	herdr-app do space.select --id "$1" >/dev/null 2>&1 || return 1
	herdr-app do tab.select --id "$2" >/dev/null 2>&1 || return 1
	return 0
}

# stale_tabs <space id> — from a `herdr-app ls` snapshot on stdin, print
# "tab<TAB>name<TAB>index<TAB>terminal" for every tab of that space whose terminals are all
# something other than pi. The terminal id is the key the resume map is written under
# (agent/extensions/herdr-resume-map.ts), so the repair has to carry it. A tab with no terminal
# is a mod, not a lost agent. A tab that still holds a live pi is left alone.
stale_tabs() {
	SPACE_ID=$1 node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(0)}
			const sp=(j.spaces||[]).find(s=>s.id===process.env.SPACE_ID);
			if(!sp)process.exit(0);
			(sp.tabs||[]).forEach((t,i)=>{
				const ts=t.terminals||[];
				if(!ts.length)return;
				if(ts.some(x=>x&&x.app==="pi"))return;
				const terminal=ts[0]&&ts[0].id?ts[0].id:"";
				process.stdout.write([t.id,t.name===null||t.name===undefined?"":t.name,i+1,terminal].join("\t")+"\n");
			});
		})'
}

# tab_of_terminal <space> <terminal> — from a `herdr-app ls` snapshot on stdin, print the id of the
# tab holding that terminal, or nothing. What `tab.new` answers with is a terminal, and the tab it
# landed in is what has to be marked as the guard's own.
tab_of_terminal() {
	SPACE_ID=$1 TERMINAL_ID=$2 node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			const sp=(j.spaces||[]).find(s=>s.id===process.env.SPACE_ID);
			if(!sp)process.exit(1);
			const hit=(sp.tabs||[]).find(t=>(t.terminals||[]).some(x=>x&&x.id===process.env.TERMINAL_ID));
			if(!hit)process.exit(1);
			process.stdout.write(hit.id);
		})'
}

# tab_class <space> <tab> — parked, guard, person, or nothing when the tab was never classified.
tab_class() {
	[ -f "$TAB_CLASSES" ] || return 0
	awk -v s="$1" -v t="$2" '$1==s && $2==t {print $3; exit}' "$TAB_CLASSES" 2>/dev/null
}

# mark_tab_class <space> <tab> <class> — record a tab as parked, the guard's own, or the person's.
mark_tab_class() {
	local space=$1 tab=$2 class=$3 tmp=$TAB_CLASSES.tmp
	: >"$tmp"
	if [ -f "$TAB_CLASSES" ]; then
		awk -v s="$space" -v t="$tab" '$1!=s || $2!=t' "$TAB_CLASSES" >>"$tmp"
	fi
	printf '%s\t%s\t%s\n' "$space" "$tab" "$class" >>"$tmp"
	mv "$tmp" "$TAB_CLASSES"
}

# classify_snapshot <space id> — from a `herdr-app ls` snapshot on stdin, write this space's tabs
# with the class each one has. A tab nobody has classified yet is parked when this is the first
# snapshot after the guard started (herdr-core has just handed the parked tabs back) and the
# person's at any later poll — the person opened it, and a tab the guard did not get from herdr is
# not its to repair. A tab holding a terminal a `tab.new` answered with is the guard's own, however
# late `ls` shows it. Prints "<name>\t<tab>" for each tab newly read as the person's, so the run
# logs it once instead of pretending the tab is still the guard's business.
classify_snapshot() {
	local space=$1 seeding=0
	[ -f "$TAB_SEED" ] || seeding=1
	CLASSES=$(native_path "$TAB_CLASSES") SPACE_ID=$space SEEDING=$seeding \
		PENDING=$(native_path "$TAB_PENDING") node -e '
		const fs=require("fs");
		const {CLASSES,SPACE_ID,SEEDING,PENDING}=process.env;
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(0)}
			const sp=(j.spaces||[]).find(s=>s.id===SPACE_ID);
			if(!sp)process.exit(0);
			const known=new Map();
			try{
				for(const l of fs.readFileSync(CLASSES,"utf8").split("\n")){
					const p=l.split("\t");
					if(p.length>=3&&p[0]===SPACE_ID)known.set(p[1],p[2]);
				}
			}catch{}
			const pending=new Map();
			try{
				for(const l of fs.readFileSync(PENDING,"utf8").split("\n")){
					const p=l.split("\t");
					if(p.length>=2&&p[0]===SPACE_ID)pending.set(p[1],l);
				}
			}catch{}
			const lines=[],person=[];
			for(const t of (sp.tabs||[])){
				let cls=known.get(t.id);
				for(const term of (t.terminals||[])){
					if(term&&pending.has(term.id)){cls="guard";pending.delete(term.id);}
				}
				if(!cls){
					cls=SEEDING==="1"?"parked":"person";
					if(cls==="person")person.push([t.name===null||t.name===undefined?"":t.name,t.id].join("\t"));
				}
				lines.push([SPACE_ID,t.id,cls].join("\t"));
			}
			fs.writeFileSync(CLASSES,lines.length?lines.join("\n")+"\n":"");
			try{fs.writeFileSync(PENDING,[...pending.values()].join("\n")+(pending.size?"\n":""))}catch{}
			for(const p of person)process.stdout.write(p+"\n");
		})'
	[ "$seeding" = 1 ] && [ -f "$TAB_CLASSES" ] && : >"$TAB_SEED"
	return 0
}

# tab_holds_pi <space> <tab> — true when one of that tab's terminals is pi again, read from a
# fresh `herdr-app ls` snapshot on stdin. What a resume is worth is what the app reports, not
# what the resume script printed.
tab_holds_pi() {
	SPACE_ID=$1 TAB_ID=$2 node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			const sp=(j.spaces||[]).find(s=>s.id===process.env.SPACE_ID);
			if(!sp)process.exit(1);
			const hit=(sp.tabs||[]).find(t=>t.id===process.env.TAB_ID);
			if(!hit)process.exit(1);
			process.exit((hit.terminals||[]).some(x=>x&&x.app==="pi")?0:1);
		})'
}

# entry_field <file> <dotted path> — one field of a resume entry, or nothing.
entry_field() { field "$2" <"$1" 2>/dev/null; }

# entry_argv <file> — the entry's launch argv as a JSON array, or nothing when it has none.
entry_argv() {
	node -e '
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{}
			if(!Array.isArray(j.argv)||!j.argv.length)process.exit(1);
			process.stdout.write(JSON.stringify(j.argv))})' <"$1" 2>/dev/null
}

# resume_entry_for_tab <space> <tab> <terminal> — the newest usable resume entry for this tab, or
# nothing. Matched by terminal id, or by the tab id (and space, when the entry has one) the entry
# recorded: after a host reboot herdr-app reports no terminal id for a parked tab, so the tab id
# in the entry is the only key left. A tab with several entries takes the newest `updated_at`; an
# entry whose session file is gone is not usable, because there is nothing to resume.
resume_entry_for_tab() {
	local space=$1 tab=$2 terminal=${3:-}
	[ -d "$RESUME_DIR" ] || return 1
	SPACE_ID=$space TAB_ID=$tab TERMINAL_ID=$terminal DIR=$(native_path "$RESUME_DIR") node -e '
		const fs=require("fs"),path=require("path");
		const {SPACE_ID,TAB_ID,TERMINAL_ID,DIR}=process.env;
		let names=[];try{names=fs.readdirSync(DIR).filter(n=>n.endsWith(".json"))}catch{process.exit(1)}
		const hits=[];
		for(const n of names){
			let e;try{e=JSON.parse(fs.readFileSync(path.join(DIR,n),"utf8"))}catch{continue}
			if(typeof e.session_path!=="string"||!e.session_path)continue;
			if(!fs.existsSync(e.session_path))continue;
			if(!Array.isArray(e.argv)||!e.argv.length)continue;
			const byTerminal=TERMINAL_ID&&e.terminal===TERMINAL_ID;
			const byTab=TAB_ID&&e.tab===TAB_ID&&(!e.space||!SPACE_ID||e.space===SPACE_ID);
			if(!byTerminal&&!byTab)continue;
			hits.push({p:path.join(DIR,n),u:String(e.updated_at||"")});
		}
		if(!hits.length)process.exit(1);
		hits.sort((a,b)=>a.u<b.u?1:a.u>b.u?-1:0);
		process.stdout.write(hits[0].p);'
}

# hc_json <terminal> — `hc get <terminal> --json`, or nothing when hc is absent or lost it.
hc_json() {
	command -v hc >/dev/null 2>&1 || return 1
	[ -n "$1" ] || return 1
	hc get "$1" --json 2>/dev/null
}

# terminal_state <terminal> — what is in that terminal right now, one word:
#   attached   a shell (or nothing yet) is there: a typed `exec` line will run;
#   unattached a live terminal whose foreground has no argv yet — not busy, just not reported;
#   busy:<cmd> something that is not a shell runs there: never type over a person or a pi;
#   unknown    hc is absent, or does not know the terminal.
terminal_state() {
	local facts
	facts=$(hc_json "$1") || { printf 'unknown'; return 0; }
	[ -n "$facts" ] || { printf 'unknown'; return 0; }
	printf '%s' "$facts" | node -e '
		const SHELLS=new Set(["sh","bash","zsh","dash","ksh","fish","nu","pwsh","powershell","elvish","xonsh"]);
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.stdout.write("unknown");return}
			if(j.state!=="live")return process.stdout.write("unknown");
			const argv=j.foreground&&j.foreground.argv;
			if(!Array.isArray(argv)||!argv.length)return process.stdout.write("unattached");
			const base=String(argv[0]).split("/").pop().toLowerCase().replace(/\.exe$/,"");
			if(SHELLS.has(base))return process.stdout.write("attached");
			process.stdout.write("busy:"+argv.join(" "));
		})'
}

# person_shell <terminal> — true when that terminal holds an interactive shell the guard did not
# start. A parked or reopened shell carries a launch argv (`exec .../bin/pi-bare`, or the
# `--session` line herdr typed); one without it is the person's own shell, and a pi typed there
# would take their session away. Unknown terminals and live terminals with no argv are not the
# person's on this reading: those are the recovered shells a repair is for.
person_shell() {
	local facts
	facts=$(hc_json "$1") || return 1
	[ -n "$facts" ] || return 1
	printf '%s' "$facts" | node -e '
		const SHELLS=new Set(["sh","bash","zsh","dash","ksh","fish","nu","pwsh","powershell","elvish","xonsh"]);
		const LAUNCH=/pi-bare|pi-sandboxed|pi-nonet|--session|herdr-resume/;
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{process.exit(1)}
			if(j.state!=="live")process.exit(1);
			const argv=j.foreground&&j.foreground.argv;
			if(!Array.isArray(argv)||!argv.length)process.exit(1);
			const base=String(argv[0]).split("/").pop().toLowerCase().replace(/\.exe$/,"");
			if(!SHELLS.has(base))process.exit(1);
			if(LAUNCH.test(argv.join(" ")))process.exit(1);
			process.exit(0);
		})'
}

# terminal_runs_pi <terminal> — true when hc reports a live program that is not a shell there.
terminal_runs_pi() {
	local state
	state=$(terminal_state "$1")
	case $state in
	attached | unattached | unknown | "") return 1 ;;
	esac
	return 0
}

# pi_there <terminal> <session path> — what a fresh look says about pi in that terminal, one word:
#   pi       a pi program is in the foreground;
#   session  a shell there already carries this very session in its argv;
#   (nothing) neither, so the terminal is a shell a resume line could go into.
# Asked immediately before a send, never earlier: between the wait and the keystroke is exactly the
# window a just-started pi needs to publish its argv.
pi_there() {
	local facts
	facts=$(hc_json "$1") || return 1
	[ -n "$facts" ] || return 1
	printf '%s' "$facts" | SESSION_ARG=$2 node -e '
		const PI=new Set(["pi","pi-bare","pi-sandboxed","pi-nonet"]);
		let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{
			let j={};try{j=JSON.parse(d)}catch{return}
			const fg=j.foreground||{};
			const argv=Array.isArray(fg.argv)?fg.argv:[];
			const all=argv.concat(Array.isArray(j.argv)?j.argv:[]);
			const base=w=>String(w).split(/[\\/]/).pop().toLowerCase().replace(/\.exe$/,"");
			// One word only: `sh -lc "exec …/pi-bare"` is a shell running a line, not a pi.
			const isPi=w=>{const s=String(w);if(/\s/.test(s))return false;const b=base(s);return PI.has(b)||(b==="cli.js"&&/[\\/]pi[\\/]/.test(s))};
			if(argv.length&&isPi(argv[0]))return process.stdout.write("pi");
			if(argv.some(isPi))return process.stdout.write("pi");
			const session=process.env.SESSION_ARG||"";
			if(session&&all.join(" ").includes(session))return process.stdout.write("session");
		})'
}

# wait_attached <terminal> — the terminal herdr-core keeps takes a moment to get its shell, and a
# live terminal whose foreground has no argv yet is *not attached*, not busy: today's lost resume
# was exactly that reading. Wait for an answer within the bound, and answer only what was seen: a
# terminal still showing no foreground after the bound comes back as `unattached`, so the caller
# decides what that means instead of this loop guessing. Nothing here upgrades a state.
wait_attached() {
	local terminal=$1 tries=${PI_BOSS_ATTACH_TRIES:-4} gap=${PI_BOSS_ATTACH_GAP:-1} state='' i
	for ((i = 0; i < tries; i++)); do
		state=$(terminal_state "$terminal")
		case $state in
		attached | busy:*) printf '%s' "$state"; return 0 ;;
		unknown) printf 'unknown'; return 0 ;;
		esac
		[ "$i" -lt $((tries - 1)) ] && sleep "$gap"
	done
	# No pass at all is no observation, so it is not a licence to type either.
	printf '%s' "${state:-unknown}"
}

# resumed_this_boot <terminal> / mark_resumed <terminal> — the guard's own "typed once" ledger.
resumed_this_boot() {
	[ -f "$RESUMED" ] || return 1
	awk -v b="$BOOT" -v t="$1" '$1==b && $2==t{f=1} END{exit !f}' "$RESUMED"
}

mark_resumed() {
	printf '%s %s\n' "$BOOT" "$1" >>"$RESUMED"
}

# exec_line <argv json> <session path> — the shell line the resume script would type.
exec_line() {
	ARGV=$1 SESSION=$2 node -e '
		const q=w=>/^[A-Za-z0-9_@%+=:,./-]+$/.test(w)?w:"'\''"+String(w).replace(/'"'"'/g,"'"'"'\\'"'"''"'"'")+"'\''";
		const words=[...JSON.parse(process.env.ARGV),"--session",process.env.SESSION];
		process.stdout.write("exec "+words.map(q).join(" "))'
}

# tab_has_pi <space> <tab> — what herdr-app says, from a fresh snapshot.
tab_has_pi() { herdr-app ls 2>/dev/null | tab_holds_pi "$1" "$2"; }

# resume_via_entry <entry> <space> <tab> <name> — do the script's job here, on the entry's own
# terminal: `hc send` the same exec line into the recovered shell, then wait for pi. Used when
# herdr-resume.mjs declined, and when herdr-app has no terminal for the tab but hc knows the one
# the entry recorded. Returns 0 when pi is running in the tab afterwards, 2 when this boot already
# restored that session (nothing to do, and typing again would be a second pi), 3 when the terminal
# must not be typed into at all (no shell prompt yet, or pi is already there — nothing is opened or
# closed for that), 1 otherwise.
resume_via_entry() {
	local entry=$1 space=$2 tab=$3 name=$4 terminal session argv line state i
	terminal=$(entry_field "$entry" terminal)
	session=$(entry_field "$entry" session_path)
	argv=$(entry_argv "$entry") || { log "tab $name ($tab) has an entry $entry with no launch argv; not resuming"; return 1; }
	[ -n "$terminal" ] && [ -n "$session" ] || { log "tab $name ($tab) entry $entry has no terminal or session path; not resuming"; return 1; }
		if [ -n "$BOOT" ] && [ "$(entry_field "$entry" restored_boot_id)" = "$BOOT" ]; then
		log "tab $name ($tab) was already resumed in this boot (entry $entry); not typing a second time"
		return 2
	fi
	if resumed_this_boot "$terminal"; then
		log "terminal \`$terminal\` in tab $name ($tab) was already resumed in this boot; not typing a second time"
		return 2
	fi
	local there
	state=$(wait_attached "$terminal")
	case $state in
	busy:*)
		log "could not resume terminal \`$terminal\` in tab $name ($tab): something else is running there (${state#busy:}); not typing over it"
		return 1
		;;
	unknown)
		log "could not resume terminal \`$terminal\` in tab $name ($tab): hc does not know that terminal"
		return 1
		;;
	unattached)
		# A live terminal with no foreground argv is a pi that has not published its argv yet as
		# often as it is a shell that has not attached. Typing here put a resume line into a running
		# pi once; the tab is left for the next poll instead, and a genuinely dead terminal reads
		# `unknown`, which still takes the reopen path.
		log "terminal \`$terminal\` in tab $name ($tab) has no shell prompt yet (foreground has no program); not typing into it, a pi that is still starting looks the same"
		return 3
		;;
	esac
	# Last instant before the send: the tab must not already hold pi, and the shell there must not
	# already carry this session. Asked again here, not one poll earlier, because this is the moment
	# the line goes in.
	if tab_has_pi "$space" "$tab"; then
		log "tab $name ($tab) already has pi running (session $session); nothing to resume"
		return 3
	fi
	there=$(pi_there "$terminal" "$session")
	if [ "$there" = pi ] || [ "$there" = session ]; then
		log "tab $name ($tab) already has pi running (session $session); nothing to resume"
		return 3
	fi
	command -v hc >/dev/null 2>&1 || { log "could not resume terminal \`$terminal\` in tab $name ($tab): hc is not on PATH"; return 1; }
	line=$(exec_line "$argv" "$session")
	if ! hc send "$terminal" "$line" >/dev/null 2>&1; then
		log "could not resume terminal \`$terminal\` in tab $name ($tab): hc send failed"
		return 1
	fi
	mark_resumed "$terminal"
	for ((i = 0; i < ${PI_BOSS_RESUME_START_WAIT:-10}; i++)); do
		if tab_has_pi "$space" "$tab" || terminal_runs_pi "$terminal"; then
			log "resumed terminal \`$terminal\` in tab $name ($tab) with hc from $entry ($line); the tab keeps its session, nothing was opened or closed"
			return 0
		fi
		sleep 1
	done
	log "typed the session into terminal \`$terminal\` in tab $name ($tab) but pi did not start; pi is not running there"
	return 1
}

# resume_entries — run ~/.pi's resume script for every entry it has. The script already decides
# per terminal: it skips a busy terminal, a terminal whose pi exited on its own, a session file
# that is gone, and an entry it restored in this boot, and it never starts a second pi. The waits
# are shortened so a repair cannot stall the poll, and the whole call is bounded.
resume_entries() {
	local script=$RESUME_SCRIPT runner
	[ -f "$script" ] || script=$RESUME_FALLBACK
	[ -f "$script" ] || { printf 'no resume script at %s or %s' "$RESUME_SCRIPT" "$RESUME_FALLBACK"; return 1; }
	if [ -x "$script" ]; then
		runner=$script
	else
		command -v node >/dev/null 2>&1 || { printf 'node not found; cannot run %s' "$script"; return 1; }
		runner=node
	fi
	if ! command -v timeout >/dev/null 2>&1; then
		# Without timeout the script's own waits still bound it: a few seconds per entry.
		RESUME_TIMEOUT=0
	fi
	if [ "$RESUME_TIMEOUT" = 0 ]; then
		env PI_HERDR_RESUME_WAIT_MS="${PI_HERDR_RESUME_WAIT_MS:-5000}" \
			PI_HERDR_RESUME_ENTRY_MS="${PI_HERDR_RESUME_ENTRY_MS:-3000}" \
			PI_HERDR_RESUME_START_MS="${PI_HERDR_RESUME_START_MS:-8000}" \
			PI_HERDR_RESUME_DIR=$(native_path "$RESUME_DIR") \
			"$runner" "$script" 2>&1
		return 0
	fi
	env PI_HERDR_RESUME_WAIT_MS="${PI_HERDR_RESUME_WAIT_MS:-5000}" \
		PI_HERDR_RESUME_ENTRY_MS="${PI_HERDR_RESUME_ENTRY_MS:-3000}" \
		PI_HERDR_RESUME_START_MS="${PI_HERDR_RESUME_START_MS:-8000}" \
		PI_HERDR_RESUME_DIR=$(native_path "$RESUME_DIR") \
		timeout "$RESUME_TIMEOUT" "$runner" "$script" 2>&1
}

# repair_key <space id> <name> <index> — what the rate limit is counted on. The tab id changes
# with every repair, so counting on it would let a broken pi be reopened every poll; the tab's
# name and place survive, so the minute is counted there.
repair_key() { printf '%s:%s:%s' "$1" "${2// /_}" "$3"; }

repaired_recently() {
	[ -f "$REPAIRS" ] || return 1
	awk -v k="$1" -v c="$(($(date +%s) - REPAIR_EVERY))" \
		'$1==k && $2>=c {found=1} END{exit !found}' "$REPAIRS"
}

mark_repaired() {
	printf '%s %s\n' "$1" "$(date +%s)" >>"$REPAIRS"
	if [ "$(wc -l <"$REPAIRS" 2>/dev/null || echo 0)" -gt 200 ]; then
		tail -n 200 "$REPAIRS" >"$REPAIRS.tmp" && mv "$REPAIRS.tmp" "$REPAIRS"
	fi
}

# kickoff_later <terminal> — send the first message once pi has had time to boot, off the loop.
kickoff_later() {
	(
		sleep "$KICKOFF_WAIT"
		if hc send "$1" "$KICKOFF" >/dev/null 2>&1; then
			log "kickoff sent to $1"
		else
			log "could not send the kickoff message to $1"
		fi
	) &
}

# repair_tab <space> <tab> <name> <index> <terminal> — 0 when it repaired the tab, 2 when it left
# the tab alone on purpose (rate-limited, the person's own, already resumed in this boot), 1 when a
# repair was attempted and failed.
# Two paths, in this order:
#   1. the tab has a resume entry, by its terminal id or by the tab id in the entry — let the
#      ~/.pi resume script run, then, when that declined, do the same job here with `hc send` on
#      the entry's terminal. Either way the end state is pi running on the recorded session, and
#      nothing is opened or closed;
#   2. no usable entry, or the resume did not put pi back — open the replacement first and close
#      the stale tab after: closing a space's only tab would end the space, and a failed open leaves
#      the person with what they had. Same name, same place, and an absolute argv so the holder
#      can restart it. The boss tab (master) gets the kickoff message again.
repair_tab() {
	local space=$1 tab=$2 name=$3 index=$4 terminal=${5:-} boss=0 argv out new_terminal new_tab args=() key entry
	key=$(repair_key "$space" "$name" "$index")
	repaired_recently "$key" && return 2
	[ "$name" = master ] && boss=1

	if entry=$(resume_entry_for_tab "$space" "$tab" "$terminal"); then
		local resumed entry_terminal
		entry_terminal=$(entry_field "$entry" terminal)
		resumed=$(resume_entries)
		mark_repaired "$key"
		# The script is the component that knows a recovered shell; then the guard checks itself,
		# by what herdr-app says about the tab and by what hc says about the entry's terminal, so a
		# pi the script did start is never typed over.
		if tab_has_pi "$space" "$tab" || terminal_runs_pi "$entry_terminal"; then
			log "resumed terminal \`$entry_terminal\` in tab $name ($tab) from $entry; the tab keeps its session, nothing was opened or closed"
			return 0
		fi
		# Declined — often "busy (no program)" on a live terminal that has no argv yet. Do it here.
		resume_via_entry "$entry" "$space" "$tab" "$name"
		case $? in
		0) return 0 ;;
		2)
			# Already restored in this boot and pi is gone: the person let it go. Leave the tab be.
			log "tab $name ($tab) already had its session resumed in this boot; leaving it alone"
			return 2
			;;
		3)
			# No shell prompt to type into, or pi is already there: the refusal is logged, and the
			# tab is left exactly as it is. Reopening it here would kill the pi it may be holding.
			return 2
			;;
		esac
		log "could not resume terminal \`$entry_terminal\` in tab $name ($tab); opening a new pi instead: $(printf '%s' "$resumed" | tail -n 2 | tr '\n' ' ')"
	else
		# A live pi the app has not reported yet is still a live pi: closing its tab or opening a
		# second one over it is the same mistake as typing into it.
		if tab_has_pi "$space" "$tab" || [ "$(pi_there "$terminal" "")" = pi ]; then
			log "tab $name ($tab) already has pi running in terminal \`${terminal:-unknown}\`; nothing to repair"
			return 2
		fi
		# The tab never held pi. It is the guard's to repair only if the person has not made it their
		# own: an interactive shell without a recovered launch argv is the person's tab, and a pi
		# typed there would take it away. Rate-limited like a repair, so the line is one a minute.
		if person_shell "$terminal"; then
			log "tab $name ($tab) left alone: it is the person's tab (interactive shell on terminal \`$terminal\` that the guard did not start)"
			mark_repaired "$key"
			return 2
		fi
		log "tab $name ($tab) opened fresh: terminal \`${terminal:-unknown}\` has no entry in $RESUME_DIR, so it never held pi"
	fi

	argv=$(pi_argv "$boss")
	[ -n "$name" ] && args+=(--name "$name")
	out=$(herdr-app do tab.new --space "$space" "${args[@]}" --folder "$ROOT_NATIVE" --argv "$argv" 2>&1)
	new_terminal=$(printf '%s' "$out" | field terminal)
	[ -n "$new_terminal" ] || new_terminal=$(printf '%s' "$out" | field result.terminal)
	if [ -z "$new_terminal" ]; then
		log "could not open a replacement for the stale tab $name ($tab): $out"
		return 1
	fi
	mark_repaired "$key"
	log "opened a new pi in tab $name ($tab -> terminal \`$new_terminal\`) with $argv"
	# The tab the guard opened is the guard's own, and it stays repairable through a restart: a tab
	# nobody classified is a person's at the next poll, and a pi that died in here has to come back.
	new_tab=$(herdr-app ls 2>/dev/null | tab_of_terminal "$space" "$new_terminal")
	if [ -n "$new_tab" ]; then
		mark_tab_class "$space" "$new_tab" guard
	else
		# `ls` had not caught up with the new tab. Keep the terminal it answered with: the next
		# snapshot reads the tab it landed in as the guard's, not as another terminal of the person's.
		printf '%s\t%s\n' "$space" "$new_terminal" >>"$TAB_PENDING"
		tail -n 50 "$TAB_PENDING" >"$TAB_PENDING.tmp" && mv "$TAB_PENDING.tmp" "$TAB_PENDING"
	fi
	out=$(herdr-app do tab.close --id "$tab" --confirmed true 2>&1) ||
		log "could not close the stale tab $name ($tab); it is still open beside \`$new_terminal\`: $out"
	herdr-app do tab.move --id "$new_terminal" --index "$index" >/dev/null 2>&1
	[ "$boss" = 1 ] && command -v hc >/dev/null 2>&1 && kickoff_later "$new_terminal"
	return 0
}

# repair_stale_tabs <space id> — repair every stale tab of the space, then put the person back
# on the space and tab they were looking at. A failed restore is one line, never a failed repair.
repair_stale_tabs() {
	local space=$1 snapshot=$2 stale tab name index before touched=0 failed=0 class
	# Before anything is repaired: which of these tabs are the guard's to repair at all.
	classify_snapshot "$space" <<<"$snapshot" |
		while IFS=$'\t' read -r name tab; do
			[ -n "$tab" ] || continue
			log "tab $name ($tab) is the person's: it was opened while the guard runs, so no pi is opened in it, nothing is closed and nothing is renamed"
		done
	stale=$(printf '%s' "$snapshot" | stale_tabs "$space") || return 0
	[ -n "$stale" ] || return 0
	before=$(screen_state)
	while IFS=$'\t' read -r tab name index terminal; do
		[ -n "$tab" ] || continue
		class=$(tab_class "$space" "$tab")
		# The person's tab is not stale, it is a tab: never repaired, never closed, never renamed —
		# unless it carries a resume entry, because then it held pi and the session is waiting.
		if [ "$class" = person ] && ! resume_entry_for_tab "$space" "$tab" "$terminal" >/dev/null; then
			continue
		fi
		repair_tab "$space" "$tab" "$name" "$index" "$terminal"
		case $? in
		0) touched=1 ;;
		2) : ;; # left alone on purpose: rate-limited, the person's, or already resumed this boot
		*)
			# A tab that cannot be put back is logged and left as it is; it must not stop this pass
			# from finishing, nor the space from being rebuilt after it is closed.
			failed=1
			;;
		esac
	done <<<"$stale"
	if [ "$failed" = 1 ]; then
		log "at least one tab could not be repaired this pass; the next interval tries again"
	fi
	if [ "$touched" = 1 ] && [ -n "$before" ]; then
		restore_focus ${before} ||
			printf 'guard: could not restore focus to space %s tab %s after repairing %s\n' \
				"${before%% *}" "${before##* }" "$SPACE_NAME" >&2
	fi
	[ "$failed" = 0 ]
}

ensure() {
	local snapshot space tabs_failed=0
	snapshot=$(herdr-app ls 2>/dev/null) || snapshot=""
	space=$(printf '%s' "$snapshot" | space_id) || {
		# Log the transition, not every poll: a closed window is normal.
		app_down || log "herdr-app not answering; waiting"
		set_app_down 1
		return 0
	}
	# Herdr (re)started: put the person on big-boss-pi once, then never steal focus again.
	if app_down; then
		log "herdr-app answered again"
		set_app_down 0
		herdr-app do space.select --id "$space" >/dev/null 2>&1 && log "selected $SPACE_NAME ($space)"
	fi
	if [ -z "$space" ]; then
		# One failed creation is one pass, not the end: the space still has to come back on the next
		# interval, whatever was wrong with this attempt (a closed window, a bad argv, a slow app).
		create_space || {
			log "could not create $SPACE_NAME this pass; the next interval tries again"
			return 1
		}
		# A space the guard created has never been on screen: nothing has selected it yet. On a clean
		# install — the Windows first run — Herdr would answer every later poll with a space nobody is
		# looking at, which reads as "Herdr opened empty". Select it once, here, and never again.
		local created
		created=$(known_space)
		if [ "$1" = "select" ] && [ -n "$created" ]; then
			herdr-app do space.select --id "$created" >/dev/null 2>&1 &&
				log "selected $SPACE_NAME ($created)"
		fi
		return 0
	fi
	local known
	known=$(known_space)
	if [ "$space" != "$known" ]; then
		printf '{"space":"%s","created":"%s"}\n' "$space" "$(iso_now)" >"$SPACE_STATE"
	fi
	# The tab repairs are this pass's work; a failure among them is reported to the loop, which
	# logs it and stays on the interval.
	repair_stale_tabs "$space" "$snapshot" || tabs_failed=1
	if [ "$1" = "select" ]; then
		herdr-app do space.select --id "$space" >/dev/null 2>&1 && log "selected $SPACE_NAME ($space)"
	fi
	return "$tabs_failed"
}

# Dispatch only when executed: sourcing this file just gives you the functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	# The old workspace's space is not ours to keep alive, repair, or select.
	if [ "$SPACE_NAME" = pi-master ]; then
		printf 'guard: refusing to guard a space named pi-master\n' >&2
		exit 0
	fi
	need_app || { log "herdr-app not on PATH; exiting"; exit 0; }
	log "guard started (space $SPACE_NAME, root $ROOT, interval ${INTERVAL}s)"
	set_app_down 0

	# Recreate immediately, and put the person on it: that is "open when Herdr starts".
	ensure select || log "the first pass failed; the loop keeps trying"

	# One poll and out: a test drives a repair without waiting for the interval, and a person can
	# ask for one repair without starting a service.
	[ "${PI_BOSS_ONCE:-0}" = 1 ] && exit 0

	# Every pass in a subshell: a fatal error inside one pass (a bad tab, a stub that is not there,
	# an unbound variable) ends *that* pass and not the guard. The space was closed once and never
	# came back because one broken iteration was allowed to be the last one.
	while sleep "$INTERVAL"; do
		(ensure "") || log "iteration failed; staying on the interval and trying again next poll"
	done
fi
