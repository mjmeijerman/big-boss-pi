#!/bin/sh
# space moved to the pi repo (~/.pi/bin/space); this shim stays for scripts that call it by this
# path. Executed, it hands over; sourced (bin/preflight and bin/publish read space's helpers), it
# hands over its functions the same way -- the real file only dispatches when it is executed.
tool="$HOME/.pi/bin/space"
if [ ! -x "$tool" ]; then
	printf 'bin/space: %s is missing — the tool lives in the pi repo (~/.pi/bin/space); install it there\n' "$tool" >&2
	exit 127
fi
if [ -n "${BASH_SOURCE[0]:-}" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
	. "$tool"
else
	exec "$tool" "$@"
fi
