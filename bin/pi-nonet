#!/usr/bin/env bash
# Worker mode: no network at all, for running untrusted repository scripts.
# Never for an agent that needs a model: no network means no model.
#
# Specs and reports are bound read-write for the same reason as in pi-sandboxed.
set -uo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
root=${PI_BOSS_ROOT:-${PI_MASTER_ROOT:-$root}}
export PATH="${PATH:-/usr/local/bin:/usr/bin:/bin}:/home/mark/.local/share/pnpm/bin"
seeds=()
for d in "$root/specs" "$root/reports"; do
	[ -d "$d" ] && seeds+=(--rw "$d")
done
exec /home/mark/.pi/scripts/pisandbox --no-net "${seeds[@]+"${seeds[@]}"}" -- "$@"
