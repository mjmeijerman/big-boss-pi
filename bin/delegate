#!/bin/sh
# delegate moved to the pi repo (~/.pi/bin/delegate); this shim stays for scripts that call it by this path.
tool="$HOME/.pi/bin/delegate"
if [ ! -x "$tool" ]; then
	printf 'bin/delegate: %s is missing — the tool lives in the pi repo (~/.pi/bin/delegate); install it there\n' "$tool" >&2
	exit 127
fi
exec "$tool" "$@"
