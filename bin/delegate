#!/usr/bin/env bash
# delegate — the only way an agent in big-boss-pi starts work.
#
#   delegate spawn <slug> --cwd DIR [--mode bare|sandboxed|no-net] [--thinking LEVEL]
#                  [--acceptance] [--override-jev --reason TEXT] [--no-restore] "<task>"
#   delegate wait <slug> [--timeout SECONDS]
#   delegate list
#   delegate close <slug> [--merged PR-URL-OR-NUMBER]
#   delegate close <slug> --nothing "<why nothing landed>"   (a worker whose change never landed)
#   delegate ask "<question>" [--json]
#   delegate stats [--since DURATION] [--json]
#   delegate sweep
#   delegate wipe <slug> [--skip "<reason>"]
#
# A worker gets its own Herdr space (never the big-boss-pi space), a spec in specs/<slug>.md,
# and one place to report back: reports/<slug>.md.
#
# Spawning does not move the person's view. space.new always shows the new space, so spawn
# records the selected space and tab first and selects them again afterwards; on screen you
# stay where you were, and the worker's space is there when you want it. If the view cannot be
# read or put back, spawn prints one warning and carries on: a started worker is never thrown
# away over a view. --no-restore keeps the old behaviour, for watching the worker appear.
#
# A worker space never outlives its report: once reports/<slug>.md exists, the space is closed
# as soon as the report has been relayed. The one exception is a report whose first line reads
# "DECISION NEEDED: <question>": that marker keeps the space open until the user answers.
# `delegate sweep` applies exactly that rule to every tracked worker in one go.
#
# A second opinion is a worker that has not seen the code. `delegate spawn SLUG --acceptance
# --cwd DIR specs/some-spec.md` turns a spec into failing acceptance tests instead of an
# implementation: the generated spec orders the worker to read that spec file and the interfaces
# it names, never the implementation files of the change, to write one failing test per behaviour
# the spec states, to raise DECISION NEEDED instead of guessing where the spec is silent, to
# commit only test files and to leave production code untouched. The report has to show the tests
# failing against the current tree, because a test that already passes proves nothing about work
# not yet done. The mode is auditable: the spawn's state line and its printed result both carry
# `acceptance`, so a later reader can tell a second opinion from an implementer without reading
# the spec.
#
# Work in flight is capped by review, not by generation. A report is "read" once something marks
# it so: `delegate wait` and `delegate close` write state/read/<slug> as they print or check the
# report, and nothing else does. While a reported worker in a --cwd still has no marker, the boss
# has not looked at what already landed there. The block is by area, not by directory: each unread
# worker's paths come from its own branch (`git diff --name-only` against the merge base with the
# origin trunk) and the new task's paths come from the paths the task text names, so only an
# overlapping unread report refuses — with the queue and both path lists — while a task that
# touches different files, or names no path at all, goes through with a note saying why.
# --override-jev --reason '<why the queue can wait>' goes through and lands as a command
# "in-flight" line in state/decisions.jsonl, which is written either way. Generation outrunning
# review is invisible until it is counted, which is why `delegate stats` prints the unread queue
# and the age of its oldest report with no network and no gh.
#
# Between features there is one more step, and `delegate close` enforces it: `delegate wipe
# <slug>` prints the five consolidation questions — what did this feature make unnecessary, what
# is duplicated, could the next feature land in this area in 30 minutes, what did we learn, what
# would we re-implement from scratch — and records the step in state/decisions.jsonl. A step that
# does not apply is recorded too, as `--skip "<reason>"`, with the reason, instead of being
# dropped silently. A close with no wipe line for that slug is refused, because a rule nothing
# checks is gone (blip 20).
#
# A report is a claim until it carries output. So `delegate close` refuses a report with no
# `## Evidence` block, or one that still has fill-in placeholders left in it: it prints what is
# missing and how to fix it, and exits nonzero without closing the space. The generated spec
# carries the scaffold, command line and fence included, so the block is copied into the report
# and deleting it is a decision; the worker stays idle and its space stays open, so the evidence
# is one edit away instead of lost. The spec and report templates say the same thing to the
# worker, earlier: "should work", "looks correct" and "tests pass" are banned without the output
# that shows it. Plausible is not working — the genie is plausible by default, so the harness asks
# for the transcript.
#
# Provenance is demanded in the shape the commit can still be given it in. A report's commit
# must carry the `Agent-Slug` trailer, which is one `git commit --amend` away while the branch
# is unmerged. A commit that is already in trunk cannot be amended — that is a rewrite of
# trunk — so `delegate close <slug> --merged <pr-url-or-number>` is the documented escape, and
# it closes on one of two verdicts, each with a warning and a row in state/decisions.jsonl
# carrying slug, sha, pr and the reason. Provenance recorded after the fact is visible
# provenance; a silent pass is not. Four outcomes, and no others: without the flag nothing
# changes; a commit that is an ancestor of origin/<trunk> closes exactly as before; a commit
# that is not an ancestor but whose patch git marks as already upstream closes as the *same
# change under another sha*, because this repo squash-merges and the landed squash is never the
# worker's own commit — `git cherry origin/<trunk> <sha>` prints `-`, which is what `git
# patch-id --stable` says; and anything git marks `+`, or cannot compute at all, refuses, with
# the refusal saying which of the two it was. Nothing else is evidence: no commit count, no
# similarity, no "close enough".
#
# Two caveats the verdict inherits from git, both refused rather than guessed through. `git
# cherry` compares a commit's diff against its parent, so a squash that also touched
# neighbouring lines reads `+` although the content is in; that case is refused with its own
# message and its own two fixes, since amendment and a manual record are different moves. And a
# landing that was later reverted still reads `-`, because the landing commit is still reachable
# from trunk — so a `-` is not taken on its own: the change must also still be in origin/<trunk>'s
# tree, or the close is refused as a reverted landing with the landing commit named. That check
# reads content by un-making the commit's patch in a throwaway index, which is also what tells
# the two `+` cases apart. It can read a squash whose neighbouring lines moved as "not there",
# and then the refusal says so and offers the one honest way through: name the landed commit in
# the report. The row keeps both shas — the report's and the landed one — for a human to check
# instead of a bare yes. A commit whose parent has not been fetched is refused as "fetch first",
# never read as `+`.
#
# Every spawn asks Jev, unconditionally, for the count, the mode, the route (local or remote) and
# the thinking effort — in one call (`jev plan`), because four questions about the same task are
# one judgement and four latencies. One call, one usage line, and the same gates: every field is
# validated the way its own subcommand validates it, and an unusable field or a dead model aborts
# the spawn instead of guessing. The four answers are still recorded as four decision lines
# (count, mode, route, thinking), each carrying jev's own answer. Routing is a refusal, not a
# warning: a task Jev calls "local" stops the spawn and prints the cheaper bin/local-run command
# to run instead. A caller's --mode or --thinking is accepted only when it matches Jev's answer
# for that exact task text; otherwise the spawn aborts and prints Jev's answer. Overriding Jev — a
# mode, a thinking level or a local route — needs --override-jev with a non-empty --reason, and the
# override is recorded. If Jev is unreachable or unsure, the spawn aborts instead of guessing:
# that decision belongs to the user. An "unsure" route is recorded and the spawn continues.
#
# Jev's count is honoured, not noted. A task that needs three workers starts three spaces,
# `SLUG`, `SLUG-2`, `SLUG-3`, each with its own spec and report file, the same task text plus its
# position in the group, and the same mode and thinking level. Count 1 is exactly the old
# behaviour and the old slug. A count that would cross the live-worker ceiling refuses rather than
# quietly starting one, because a count jev gave and the boss dropped is a decision nobody made.
#
# Thinking is the one decision with two halves. Jev answers an abstract effort, low | medium |
# high: it cannot know which thinking levels the worker's model supports. So the effort is
# mapped here, against the model the worker will actually start with
# (worker_thinking_level): the user's pi settings name that model, the model catalogue says
# which levels it supports (thinkingLevelMap, where null marks an unsupported level), and the
# effort goes to the nearest supported level, ties to the lower one. When the catalogue cannot
# be read the effort name is passed through and pi clamps it to the model.
#
# Every decision lands in state/decisions.jsonl as one JSON line: timestamp, command, task
# text, jev decision, jev reason, whether it was overridden, and the resulting slug. The route
# is the third line for a task (command "route"), the thinking level the fourth (command
# "thinking"). `delegate ask` writes the same line for a question put to jev before it ever
# reaches the user.
#
# `overridden` is per line and means one thing: this decision was overturned by
# --override-jev. Each line also carries `jev`, the answer jev actually gave, so a reader can
# check the flag instead of trusting it. Rows written before that fix are spawn-wide (the flag
# sat on all four lines of an overridden spawn, so a route jev answered "remote" could read as
# overridden); `delegate stats` counts them as legacy instead of re-interpreting them.
#
# `delegate stats` reads this file and state/usage.jsonl and prints one screen: jev calls per
# command, the route/mode/thinking splits, how often jev was overruled, and whether the local
# work path (bin/local-run) ever ran. It exists because "is the local model used" used to be
# answerable only by inference.
#
# The base a worker cuts from is fetched and brought up to date here, before the space exists:
# a sandboxed worker cannot fetch, so a stale trunk would put a PR on an old base. Trunk is
# fast-forwarded only when it is a clean, strictly-behind ancestor; dirty, ahead or diverged
# trunk refuses the spawn with the state named, and nothing is ever reset, rebased or forced.
#
# Radar Vol. 35: blip 1 (agent sandboxing, Adopt), blip 21 (subagents, Trial — capped at 4),
# blip 17 (risk-tiered human oversight — the mode decides how much rope a worker gets).
#
# The base a worker cuts from is fetched and brought up to date here, before the space exists:
# a sandboxed worker cannot fetch, so a stale trunk would put a PR on an old base. Trunk is
# fast-forwarded only when it is a clean, strictly-behind ancestor; dirty, ahead or diverged
# trunk refuses the spawn with the state named, and nothing is ever reset, rebased or forced.
set -euo pipefail

# ROOT: PI_BOSS_ROOT wins, PI_MASTER_ROOT is the deprecated fallback, then this script's tree.
self_root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
# The tree this script lives in, as opposed to ROOT (which a caller may point elsewhere).
# Programs are found here; state and the jev stub are found under ROOT.
self_bin=$self_root/bin
ROOT=${PI_BOSS_ROOT:-${PI_MASTER_ROOT:-$self_root}}
BIN=$ROOT/bin
STATE=$ROOT/state
SPECS=$ROOT/specs
REPORTS=$ROOT/reports
DELEGATIONS=$STATE/delegations.json
DECISIONS=$STATE/decisions.jsonl
READ_MARKS=$STATE/read

prog=delegate
die() { printf '%s: error: %s\n' "$prog" "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"; }

json_field() { node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let j={};try{j=JSON.parse(d)}catch{}const v=process.argv[1].split(".").reduce((a,k)=>a?.[k],j);if(v!==undefined&&v!==null)process.stdout.write(String(v))})' "$1"; }

valid_slug() { case $1 in [a-z0-9]*) ;; *) return 1 ;; esac; printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}$'; }

# report_needs_decision <report> -- true when the report opens with a DECISION NEEDED line.
# That marker is the only thing that keeps a worker space open once the report exists. A report
# that is absent or empty means the worker is still working: a keep for the sweep, never a close.
report_needs_decision() {
	local report=${1:-}
	[ -f "$report" ] || return 1
	head -n 20 -- "$report" | grep -qiE '^[[:space:]]*[*_>#-]*[[:space:]]*decision needed[[:space:]]*:'
}

# mark_read <slug> -- records that reports/<slug>.md has been read: one empty file per worker in
# state/read/. It is the only thing that clears the in-flight block in cmd_spawn, so the two
# writing commands are the ones that actually show the boss the report: `delegate wait` (it prints
# it) and `delegate close` (it checks it). A marker is a fact on disk, not a memory: the boss
# cannot be asked to remember which report it already relayed.
mark_read() {
	mkdir -p "$READ_MARKS"
	: >"$READ_MARKS/$1"
}

# unread_reports_in <cwd> -- one line per tracked worker in <cwd> whose report exists, has
# content, and has no read marker: "<slug> <age-seconds> <report> <branch>". Age is the report's
# mtime, the moment the worker wrote it. Empty output means nothing in that area is waiting to be
# read. A worker with no report is still working, not unread, so it never blocks. The branch is
# what cmd_spawn reads the worker's touched paths from: a report names what the worker says it
# did, the branch diff names what it actually changed.
unread_reports_in() {
	[ -f "$DELEGATIONS" ] || return 0
	node -e '
		const fs = require("fs"), path = require("path");
		let j = {}; try { j = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch {}
		const marks = process.argv[2], cwd = path.resolve(process.argv[3]), now = Date.now();
		for (const slug of Object.keys(j)) {
			const r = j[slug] || {};
			if (!r.report || path.resolve(String(r.cwd || "")) !== cwd) continue;
			let st; try { st = fs.statSync(r.report); } catch { continue; }
			if (!st.size) continue;
			if (fs.existsSync(path.join(marks, slug))) continue;
			process.stdout.write([slug, Math.max(0, Math.round((now - st.mtimeMs) / 1000)), r.report, r.branch || ""].join(" ") + "\n");
		}' "$DELEGATIONS" "$READ_MARKS" "$1"
}

# worker_paths <cwd> <branch> -- the paths a worker's branch actually changes, one per line, and
# nothing when that cannot be read (no branch recorded, no origin trunk, no merge base). A report
# says what the worker believes it did; this says what the tree says, which is the side the next
# worker would collide with. The diff is against the merge base with the origin trunk, so a
# branch that has fallen behind does not read as touching every file trunk touched since.
worker_paths() {
	local cwd=$1 branch=$2 trunk base
	[ -n "$branch" ] || return 0
	trunk=$(fresh_trunk_branch "$cwd")
	[ -n "$trunk" ] || return 0
	base=$(git -C "$cwd" merge-base "refs/remotes/origin/$trunk" "$branch" 2>/dev/null) || return 0
	[ -n "$base" ] || return 0
	git -C "$cwd" diff --name-only "$base" "$branch" 2>/dev/null || true
}

# task_paths <task text> -- the paths a task text names, one per line, deduplicated and sorted.
# A path is a word with a slash in it (bin/delegate, src/auth.ts, agent/extensions/): that is what
# a person writes when they mean a file, and an idea does not carry one. A URL is dropped, because
# "https://..." is a slash and not a file this repo holds. Text that names no path prints nothing:
# that is an honest "no overlap established", said out loud in cmd_spawn's note, not a silent
# "safe to overlap".
task_paths() {
	printf '%s\n' "${1:-}" | tr -s '[:space:]' '\n' \
		| sed -e 's/^[^[:alnum:]._@+~/-]*//' -e 's/[^[:alnum:]._@+~/-]*$//' \
		| grep -E '^[[:alnum:]._@+~-]+(/[[:alnum:]._@+~-]+)+/?$' \
		| sed -e 's#/*$##' | sort -u || true
}

# paths_overlap <worker-paths> <task-paths> -- the task paths that meet a worker path, one per line
# as "<task path> -> <worker path>". Two paths meet when they are equal or when one is the other's
# directory: bin/delegate and bin are the same area of work, and a worker that touched bin/delegate
# is not someone a change to bin/delegate/... can be started beside.
paths_overlap() {
	WORKER_PATHS=${1:-} TASK_PATHS=${2:-} node -e '
		const w = String(process.env.WORKER_PATHS || "").split("\n").filter(Boolean);
		const t = String(process.env.TASK_PATHS || "").split("\n").filter(Boolean);
		const meets = (a, b) => a === b || a.startsWith(b + "/") || b.startsWith(a + "/");
		const out = [];
		for (const tp of t) for (const wp of w) if (meets(tp, wp)) { out.push(tp + " -> " + wp); break; }
		process.stdout.write(out.join("\n"));
	'
}


# report_has_evidence <report> -- true when the report carries an Evidence heading with at
# least one written line under it. A heading with nothing beneath it is the same claim as no
# heading at all, so an empty block does not count. Both `## Evidence` and `**Evidence**` are
# read the same way: the heading line, stripped of #, * and spaces, is the word "evidence".
report_has_evidence() {
	local report=${1:-}
	[ -f "$report" ] || return 1
	awk '
		{
			line = $0
			gsub(/[#*]/, "", line)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
			if (!inblock) {
				if (tolower(line) ~ /^evidence([[:space:]]+block)?$/) { inblock = 1; next }
				next
			}
			if (tolower(line) ~ /^(thrown away|what i would do differently)/) exit 1
			if (line != "") found = 1
		}
		END { exit(found ? 0 : 1) }
	' "$report"
}

# report_placeholders <report> -- the fill-in placeholders still left in the report, as
# "LINE:TEXT" lines, empty when the report is written out in full. Narrow on purpose: a report
# may quote a literal <slug> in a code fence, so only the words that mean "I did not fill this
# in" are matched, and TODO/TBD/FIXME only as whole words.
#
# Fenced code blocks are pasted output, not prose: a test runner that prints "# todo 0" is
# evidence the run happened, so the scan skips every line inside a fence (three or more
# backticks or tildes; a fence closes with the same character and at least the same length).
# A fence opened and never closed is read as fenced to end of file — a report is never refused
# over pasted output — and one warning line goes to stderr, so the typo is still seen.
report_placeholders() {
	local report=${1:-}
	[ -f "$report" ] || return 0
	awk -v prog="$prog" -v file="$report" '
		{
			t = $0
			sub(/^[ \t]+/, "", t)
			if (infence) {
				if (match(t, /^(`{3,}|~{3,})/)) {
					m = substr(t, RSTART, RLENGTH)
					if (substr(t, RLENGTH + 1) ~ /^[ \t]*$/ && substr(m, 1, 1) == ch && length(m) >= len) infence = 0
				}
				next
			}
			if (match(t, /^(`{3,}|~{3,})/)) {
				m = substr(t, RSTART, RLENGTH)
				ch = substr(m, 1, 1); len = length(m); infence = 1; openline = NR; openrun = m
				next
			}
			if (tolower($0) ~ /<[[:space:]]*(fill|insert|your|add|paste|todo|tbd)|(^|[^[:alpha:]])(todo|tbd|fixme)([^[:alpha:]]|$)/) {
				printf "%d:%s\n", NR, $0
			}
		}
		END {
			if (infence) {
				printf "%s: warning: %s: unclosed %s fence opened at line %d — the rest of the file is read as fenced output\n", prog, file, openrun, openline > "/dev/stderr"
			}
		}
	' < "$report"
}

# report_commit_sha <report> -- the commit sha the report records, empty when it records none.
# A report names it on a line carrying the word "commit"; the sha is the longest run of hex
# characters of 7 to 40 on that line, which is what a short and a full sha both look like.
report_commit_sha() {
	[ -f "${1:-}" ] || return 0
	awk '
		tolower($0) ~ /commit/ {
			line = tolower($0); best = ""
			while (match(line, /[0-9a-f]+/)) {
				w = substr(line, RSTART, RLENGTH)
				if (length(w) >= 7 && length(w) <= 40 && length(w) > length(best)) best = w
				line = substr(line, RSTART + RLENGTH)
			}
			if (best != "") { print best; exit }
		}
	' "$1"
}

# commit_message <cwd> <sha> -- the full message of that commit, empty when the sha does not
# resolve in that tree. The provenance check compares a report's sha against the repo the worker
# was given, so a made-up sha fails instead of passing as a mystery.
commit_message() {
	git -C "${1:-}" log -1 --format=%B "${2:-}" 2>/dev/null
}

# wipe_recorded <slug> — true when state/decisions.jsonl carries a wipe line for that slug,
# either the step itself (decision "done") or the recorded reason it did not apply ("skipped").
# cmd_close asks this: the wipe is mandatory, and a mandatory step nobody can check is a wish.
wipe_recorded() {
	[ -f "$DECISIONS" ] || return 1
	node -e '
		const fs=require("fs");
		let lines=[];
		try{lines=fs.readFileSync(process.argv[1],"utf8").split("\n")}catch{process.exit(1)}
		for(const line of lines){
			if(!line)continue;
			let d;try{d=JSON.parse(line)}catch{continue}
			if(d.command==="wipe"&&d.slug===process.argv[2])process.exit(0);
		}
		process.exit(1);' "$DECISIONS" "$1"
}

# merged_pr_ref <text> — the PR number in a `--merged` argument, empty when the argument is not
# a PR reference at all. Three shapes, because that is what people paste: 63, #63, and the URL a
# PR page sits at. Nothing else is guessed: a branch name or a sha is not evidence of a merge.
merged_pr_ref() {
	printf '%s' "${1:-}" | sed -nE \
		-e 's/^#?([0-9]{1,9})$/#\1/p' \
		-e 's#^https?://[^/[:space:]]+/[^/[:space:]]+/[^/[:space:]]+/pull/([0-9]{1,9})/?$#\1#p' \
		| head -n 1
}

# merged_escape <slug> <sha> <cwd> <pr-arg> — the close path for a commit that is already in trunk,
# where the Agent-Slug trailer can no longer be added without rewriting trunk.
#
# Four outcomes, in this order, and the third is the only new permission in the whole command:
#   - no --merged given: today's refusal, verbatim (the caller prints it, this returns 1);
#   - --merged given and the commit is in origin/<trunk>: close, with a warning naming the short
#     sha and the PR, and one state/decisions.jsonl row (command "provenance", decision "merged")
#     carrying slug, sha, pr and the reason. Unchanged from before patch-equivalence: the cheap,
#     exact test runs first and nothing else is computed when it answers;
#   - --merged given, the commit is not an ancestor, and `git cherry` marks its patch `-`: the
#     same change landed under another sha (a squash merge), so close, with a warning naming BOTH
#     shas and the PR, and a row carrying slug, sha, pr, the landed sha and the reason — the
#     record says "these are the same change" instead of hiding one of them;
#   - anything else: refuse. `+` says the patch is not upstream, and it is refused as such, with
#     two messages because the fixes differ: plain not-in-trunk (amend the branch commit with its
#     trailers), and a squash that touched neighbouring lines so the patch-id moved although the
#     content is in (amend, or name the landed commit in the report). A commit whose parent is not
#     fetched, or a `git cherry` that cannot run, is refused as "fetch first" — never read as `+`,
#     because "git could not look" and "the change is not upstream" are different findings.
#
# The trunk side is read from origin/, never from the local branch: a local trunk can be behind or
# ahead of what was actually merged, and "is this in trunk" has one meaning — the remote's.
merged_escape() {
	local slug=$1 sha=$2 cwd=$3 prarg=$4 full trunk short pr reason flag base want landed landed_short
	local out rc c patch
	full=$(git -C "$cwd" rev-parse --verify --quiet "$sha^{commit}" 2>/dev/null) || full=$sha
	short=$(git -C "$cwd" rev-parse --short "$full" 2>/dev/null) || short=$full
	if [ -z "$prarg" ]; then
		printf '%s: refusing to close %s: %s records commit %s, and that commit has no Agent-Slug trailer, so nothing ties the change to this worker.\n' "$prog" "$slug" "$REPORTS/$slug.md" "$sha" >&2
		printf 'Fix: end that commit'"'"'s message with the two trailers, then close again:\n' >&2
		printf "  git -C %%q commit --amend --no-edit --trailer 'Agent-Slug: %s' --trailer 'Spec: specs/%s.md'\n" "$slug" "$slug" >&2
		printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
		return 1
	fi
	pr=$(merged_pr_ref "$prarg")
	if [ -z "$pr" ]; then
		die "--merged needs a PR number or a pull-request URL (63, #63, https://<host>/<owner>/<repo>/pull/63): '$prarg'"
	fi
	trunk=$(fresh_trunk_branch "$cwd")
	if [ -z "$trunk" ]; then
		printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply: %s has no origin/trunk, origin/main or origin/master, so there is no trunk to check that commit against.\n' \
			"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$cwd" >&2
		printf 'Fix: fetch the remote first (%s), or amend the commit with its trailers and close again.\n' "git -C $cwd fetch origin" >&2
		return 1
	fi
	if git -C "$cwd" merge-base --is-ancestor "$full" "refs/remotes/origin/$trunk" 2>/dev/null; then
		reason="commit $short carries no Agent-Slug trailer and is already in origin/$trunk, so the trailer cannot be added without rewriting trunk; provenance recorded after the fact from PR $pr"
		printf '%s: warning: %s records commit %s, which has no Agent-Slug trailer. That commit is already in origin/%s (PR %s), so it cannot be amended without rewriting trunk; closing anyway and recording the exception in state/decisions.jsonl.\n' \
			"$prog" "$slug" "$short" "$trunk" "$pr" >&2
		record_decision provenance "$slug" merged "$reason" false "$slug" "" \
			"$(printf '{"sha":"%s","pr":"%s","trunk":"origin/%s"}' "$full" "$pr" "$trunk")"
		return 0
	fi

	# Not an ancestor, so the squash-merge question is open. git cannot compare a patch with
	# upstream unless it can read the commit's diff, and that starts at its parent: a commit that
	# exists only locally, or in a shallow clone, has no parent here, and no answer to compare. Say
	# fetch instead of reading the silence as "not upstream".
	if ! git -C "$cwd" rev-parse --verify --quiet "$full^" >/dev/null 2>&1; then
		printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply yet: %s cannot read that commit'"'"'s parent, so its patch cannot be compared with origin/%s — a commit whose history was never fetched looks exactly like this.\n' \
			"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$cwd" "$trunk" >&2
		printf 'Fix: fetch the remote first, then close again:\n' >&2
		printf '  git -C %q fetch origin\n' "$cwd" >&2
		printf '  %s close %s --merged %s\n' "$BIN/delegate" "$slug" "$prarg" >&2
		return 1
	fi
	out=$(git -C "$cwd" cherry "refs/remotes/origin/$trunk" "$full" 2>&1) && rc=0 || rc=$?
	if [ "$rc" -ne 0 ]; then
		printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply yet: git cherry could not compare the patch with origin/%s, so "not upstream" has not been established.\n' \
			"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$trunk" >&2
		printf 'git said: %s\n' "$(printf '%s\n' "$out" | tail -n 1)" >&2
		printf 'Fix: fetch the remote first, then close again:\n' >&2
		printf '  git -C %q fetch origin\n' "$cwd" >&2
		printf '  %s close %s --merged %s\n' "$BIN/delegate" "$slug" "$prarg" >&2
		return 1
	fi
	flag=$(printf '%s\n' "$out" | awk -v s="$full" '$2 == s { print $1; exit }')
	case $flag in
	-)
		# git says an equivalent patch is already upstream. Name the landing commit, because a row
		# that says "trust me, it is in" is exactly what this check exists to avoid: the record has
		# to say which two commits are the same change.
		want=$(git -C "$cwd" show --format= "$full" 2>/dev/null | git -C "$cwd" patch-id --stable 2>/dev/null | awk 'NR == 1 { print $1 }')
		landed=""
		base=$(git -C "$cwd" merge-base "$full" "refs/remotes/origin/$trunk" 2>/dev/null) || base=""
		if [ -n "$want" ] && [ -n "$base" ]; then
			for c in $(git -C "$cwd" rev-list "refs/remotes/origin/$trunk" "^$base" 2>/dev/null); do
				patch=$(git -C "$cwd" show --format= "$c" 2>/dev/null | git -C "$cwd" patch-id --stable 2>/dev/null | awk 'NR == 1 { print $1 }')
				if [ -n "$patch" ] && [ "$patch" = "$want" ]; then
					landed=$c
					break
				fi
			done
		fi
		if [ -z "$landed" ]; then
			printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply yet: git reports the patch as already applied upstream, but no commit in origin/%s since %s carries it, so the landed sha cannot be named and the record would say less than the check knows.\n' \
				"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$trunk" "${base:-the branch point}" >&2
			printf 'Fix: name the landed commit instead — put its sha on the report'"'"'s Commit: line and close again:\n' >&2
			printf '  git -C %q log --oneline origin/%s\n' "$cwd" "$trunk" >&2
			printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
		landed_short=$(git -C "$cwd" rev-parse --short "$landed" 2>/dev/null) || landed_short=$landed
		# A landing that was later reverted is still reachable from trunk, so cherry still says `-`.
		# The content is what tells them apart, and a reverted change is not a landed change.
		if ! patch_already_in_trunk "$cwd" "$trunk" "$full"; then
			printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply: git reports its patch as applied upstream, as %s, but the change is not in origin/%s'"'"'s tree any more — the shape of a landing that was later reverted, or of a squash whose neighbouring lines moved so far that the patch no longer un-makes cleanly. Either way git cannot certify it as landed, and a reverted change has not landed.\n' \
				"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$landed_short" "$trunk" >&2
			printf 'Fix: check the revert in origin/%s first. If the landing does stand, name the landed commit on the report'"'"'s Commit: line and close again:\n' "$trunk" >&2
			printf '  git -C %q log --oneline origin/%s -- %s\n' "$cwd" "$trunk" "$(git -C "$cwd" diff-tree --no-commit-id --name-only -r "$full" 2>/dev/null | head -n 1)" >&2
			printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
		reason="commit $short carries no Agent-Slug trailer and is not itself in origin/$trunk; the same change landed there as $landed_short from PR $pr, which git cherry marks as an applied patch (git patch-id --stable), so provenance is recorded after the fact against both shas"
		printf '%s: warning: %s records commit %s, which has no Agent-Slug trailer. That commit is not in origin/%s itself, but the same change is, as %s (PR %s): git cherry reports its patch as already applied upstream. Closing anyway; state/decisions.jsonl records both shas, so the exception can be checked rather than trusted.\n' \
			"$prog" "$slug" "$short" "$trunk" "$landed_short" "$pr" >&2
		record_decision provenance "$slug" merged "$reason" false "$slug" "" \
			"$(printf '{"sha":"%s","landed":"%s","pr":"%s","trunk":"origin/%s","how":"patch-id"}' "$full" "$landed" "$pr" "$trunk")"
		return 0
		;;
	+)
		# git says the patch is not upstream. Two findings hide behind that `+`, and the fixes
		# differ, so say which one this is: a squash that also touched neighbouring lines moved the
		# patch-id while the content went in, where a plain unlanded commit is one amendment away.
		if patch_already_in_trunk "$cwd" "$trunk" "$full"; then
			printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply: git will not certify it as landed. Its change is already in origin/%s, but under a different patch-id — a squash that also touched neighbouring lines reads as not upstream in git cherry, so the content is in and git cannot prove it.\n' \
				"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$trunk" >&2
			printf 'Fix, either way: amend the branch commit with its trailers and close again (no rewrite of trunk involved):\n' >&2
			printf "  git -C %%q commit --amend --no-edit --trailer 'Agent-Slug: %s' --trailer 'Spec: specs/%s.md'\n" "$slug" "$slug" >&2
			printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
			printf '  — or, if the change really is in, put the sha of the commit that carries it in origin/%s on the report'"'"'s Commit: line and close again.\n' "$trunk" >&2
			return 1
		fi
		printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply: %s is not an ancestor of origin/%s, so it has not landed and can still be amended.\n' \
			"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$full" "$trunk" >&2
		printf 'Fix: amend that commit with its trailers and close again (no rewrite of trunk involved):\n' >&2
		printf "  git -C %%q commit --amend --no-edit --trailer 'Agent-Slug: %s' --trailer 'Spec: specs/%s.md'\n" "$slug" "$slug" >&2
		printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
		return 1
		;;
	*)
		# Neither flag: git listed no patch for this commit, which is not a finding about trunk at
		# all. Refuse and say so rather than let an unread answer pass as an answer.
		printf '%s: refusing to close %s: %s records commit %s with no Agent-Slug trailer, and --merged does not apply: git cherry named no patch for %s against origin/%s, so nothing has been established about that commit.\n' \
			"$prog" "$slug" "$REPORTS/$slug.md" "$sha" "$full" "$trunk" >&2
		printf 'Fix: fetch the remote (%s), or amend the commit with its trailers and close again.\n' "git -C $cwd fetch origin" >&2
		return 1
		;;
	esac
}

# patch_already_in_trunk <cwd> <trunk> <sha> — true when that commit's change cannot be un-made in
# origin/<trunk>'s tree because it is already there. Read as: the content is in trunk now.
#
# Two jobs, both of them refusals when it says no. On a `-` it is the guard against a landing that
# was later reverted: git cherry still sees the landing commit in trunk's history, the content is
# gone, and an accredited revert is not a landed change. On a `+` it separates a squash that also
# touched neighbouring lines (content in, patch-id moved) from a commit that never landed, which
# are refused with different fixes.
#
# Asked of a throwaway index seeded from the trunk tree, so the worker's working tree and its own
# index are never read or written. It can be wrong in the strict direction only: neighbouring
# lines that moved make it read "not there" for a change that is, and the caller then refuses and
# offers the manual path. It can never turn a `+` into a close.
patch_already_in_trunk() {
	local cwd=$1 trunk=$2 sha=$3 idx
	idx=$(mktemp "${TMPDIR:-/tmp}/delegate-trunk-index.XXXXXX") || return 1
	rm -f "$idx"
	if ! GIT_INDEX_FILE=$idx git -C "$cwd" read-tree "refs/remotes/origin/$trunk" 2>/dev/null; then
		rm -f "$idx"
		return 1
	fi
	if git -C "$cwd" show --format= "$sha" 2>/dev/null \
		| GIT_INDEX_FILE=$idx git -C "$cwd" apply --reverse --check --cached - >/dev/null 2>&1; then
		rm -f "$idx"
		return 0
	fi
	rm -f "$idx"
	return 1
}

# plan_jev <task text> [context] -- sets JEV_COUNT, JEV_MODE, JEV_ROUTE, JEV_THINKING,
# JEV_REASON from ONE `jev plan` call, and dies if Jev will not answer for any of them.
#
# One call instead of four: the four questions are one judgement about one task, and asking the
# local model four times costs four latencies (~20-60s of spawn) for answers that agree with each
# other anyway. The gates are unchanged — an unusable field, a low-confidence answer, or a dead
# model is still a refusal, never a default — and the decision lines written by the caller are
# still four, each carrying jev's own answer. The context lands on Jev's one usage line in
# state/usage.jsonl, so the call can be tied to the worker or question that caused it.
plan_jev() {
	local text=$1 ctx=${2:-} out rc
	out=$(PI_BOSS_CONTEXT="$ctx" "$BIN/jev" plan "$text" --json 2>&1) && rc=0 || rc=$?
	if [ "$rc" -ne 0 ]; then
		case $out in
		*unreachable* | *"returned nothing"* | *"HTTP "* | *"outside JSON"*)
			die "jev is unreachable or broken — refusing to guess. jev said: $out" ;;
		*)
			die "jev plan is unsure, so the spawn stops here. jev said: $out
Ask the user about the field it named. Only then re-run with --override-jev --reason '<why>'." ;;
		esac
	fi
	JEV_COUNT=$(printf '%s' "$out" | json_field count)
	JEV_MODE=$(printf '%s' "$out" | json_field mode)
	JEV_ROUTE=$(printf '%s' "$out" | json_field route)
	JEV_THINKING=$(printf '%s' "$out" | json_field thinking)
	JEV_REASON=$(printf '%s' "$out" | json_field reason)
	[ -n "$JEV_COUNT" ] && [ -n "$JEV_MODE" ] && [ -n "$JEV_ROUTE" ] && [ -n "$JEV_THINKING" ] \
		|| die "jev plan gave no usable answer: $out"
}

# record_decision <command> <task> <decision> <reason> <overridden true|false> <slug|-> [jev] [extra-json]
# `jev` is jev's own answer for that command; `overridden` is true only when <decision>
# differs from it. See the header: the flag is per line, never per spawn.
#
# `extra-json` is an object merged into the row after the standard fields, for a row that carries
# evidence of its own: the --merged escape records the sha and the PR that justify it. It is
# positional after `jev`, so callers that want extras and have no jev answer pass "" there. The
# shape of every other row is untouched — one format, read by `delegate stats` and `delegate
# list` the same way.
record_decision() {
	local cmd=$1 task=$2 decision=$3 reason=$4 overridden=$5 slug=$6 jev=${7:-} extra=${8:-}
	mkdir -p "$STATE"
	node -e '
		const fs=require("fs");
		const [file,command,task,decision,reason,overridden,slug,jev,extra]=process.argv.slice(1);
		const line={timestamp:new Date().toISOString(),command,task,decision,reason:reason||null,
			overridden:overridden==="true",slug:slug==="-"?"":slug};
		if(jev!==undefined&&jev!=="")line.jev=jev;
		if(extra)try{Object.assign(line,JSON.parse(extra))}catch{}
		fs.appendFileSync(file,JSON.stringify(line)+"\n");' \
		"$DECISIONS" "$cmd" "$task" "$decision" "$reason" "$overridden" "$slug" "$jev" "$extra"
}

# worker_thinking_level <effort> — map Jev's abstract effort (low|medium|high) to a thinking
# level the worker's model actually supports; prints {"level":…,"map":…,"model":…,"source":…}.
#
# The model is the one a fresh `pi` starts with: settings.json defaultProvider/defaultModel.
# Its `reasoning` flag and `thinkingLevelMap` come from the user's models.json first and the
# generated models-store.json second. Per pi's docs a level the map does not mention uses the
# provider default up through "high", xhigh and max are unsupported unless mapped, and null
# marks a level unsupported. A non-reasoning model runs "off". Nothing readable: the effort is
# passed through unchanged and pi clamps it, which its docs say it does.
worker_thinking_level() {
	local effort=$1 out
	out=$(node -e '
		const fs = require("fs"), path = require("path");
		const effort = process.argv[1];
		const ORDER = ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
		const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
		const home = process.env.HOME || "";
		const settings = read(path.join(home, ".pi/agent/settings.json")) || {};
		const provider = settings.defaultProvider || "";
		const model = settings.defaultModel || "";
		const emit = (o) => { process.stdout.write(JSON.stringify(o)); process.exit(0); };
		if (!model) emit({ level: effort, map: "pass-through", model: "unknown", source: "fallback-clamp" });

		let entry = null, from = "";
		for (const f of [".pi/agent/models.json", ".pi/agent/models-store.json"]) {
			const j = read(path.join(home, f)) || {};
			// models.json wraps its providers in "providers"; the generated models-store.json is
			// the provider map itself. Both are read the same way once the wrapper is gone.
			const providers = j.providers || j;
			let hit = null;
			for (const [pid, pv] of Object.entries(providers)) {
				if (provider && pid !== provider) continue;
				if (!pv || !Array.isArray(pv.models)) continue;
				hit = pv.models.find((m) => m.id === model) || null;
				if (hit) break;
			}
			if (hit) { entry = hit; from = f; break; }
		}
		if (!entry) emit({ level: effort, map: "pass-through", model: provider + "/" + model, source: "fallback-clamp" });

		const label = provider + "/" + model;
		if (entry.reasoning !== true)
			emit({ level: "off", map: effort + "→off", model: label, source: from, note: "non-reasoning model" });

		const map = entry.thinkingLevelMap || {};
		const supported = ORDER.filter((l) =>
			l === "off" ? true : l === "xhigh" || l === "max" ? Boolean(map[l]) : map[l] !== null);
		const candidates = supported.filter((l) => l !== "off");
		let level = effort;
		if (!supported.includes(effort)) {
			// Nearest supported level, ties to the lower one: jev asked for the lowest effort that
			// does the task, so rounding up spends tokens it did not ask for. "off" is the last
			// resort, never a tie-break: it drops reasoning the task was said to need.
			if (!candidates.length) level = "off";
			else {
				const target = ORDER.indexOf(effort);
				level = candidates[0];
				for (const l of candidates)
					if (Math.abs(ORDER.indexOf(l) - target) < Math.abs(ORDER.indexOf(level) - target)) level = l;
			}
		}
		emit({ level, map: level === effort ? effort + " (supported)" : effort + "→" + level,
			model: label, source: from, supported });
	' "$effort") || out=""
	[ -n "$out" ] || out=$(printf '{"level":"%s","map":"pass-through","model":"unknown","source":"fallback-clamp"}' "$effort")
	printf '%s' "$out"
}

# screen_state — the "space tab" the person is looking at, or empty when the window cannot be
# read (no window, herdr-app error). Never dies: a view that cannot be read must not stop a spawn.
screen_state() {
	local out space tab
	out=$(herdr-app status 2>/dev/null) || return 0
	space=$(printf '%s' "$out" | json_field space)
	tab=$(printf '%s' "$out" | json_field tab)
	[ -n "$space" ] && [ -n "$tab" ] || return 0
	printf '%s %s' "$space" "$tab"
}

# restore_focus <space> <tab> — select that space, then that tab, explicitly by id. Returns
# non-zero instead of dying: the caller warns and the spawn stands.
restore_focus() {
	local space=$1 tab=$2
	herdr-app do space.select --id "$space" >/dev/null 2>&1 || return 1
	herdr-app do tab.select --id "$tab" >/dev/null 2>&1 || return 1
	return 0
}

# fresh_trunk_branch <cwd> — the branch origin's HEAD points at, else the first of
# trunk/main/master the remote actually has; empty when the remote has none of them.
#
# origin/HEAD is only written by a clone or `git remote set-head --auto`, so plenty of local
# checkouts have none: the fallback list is a normal path, not the exception.
fresh_trunk_branch() {
	local cwd=$1 ref b
	ref=$(git -C "$cwd" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || ref=""
	if [ -n "$ref" ]; then printf '%s' "${ref#origin/}"; return 0; fi
	for b in trunk main master; do
		if git -C "$cwd" show-ref --verify --quiet "refs/remotes/origin/$b"; then
			printf '%s' "$b"
			return 0
		fi
	done
	return 0
}

# ensure_fresh_trunk <cwd> — a worker cuts its branch from a base the boss just fetched, never
# from a stale local trunk. Called in the spawn path, before the space exists.
#
# Why here: a sandboxed worker cannot git fetch (the sandbox refuses the ownership of the ssh
# config), so its origin/<trunk> is whatever was last fetched on the host, and a worker cut
# from that stale base ships a PR against an old trunk. The boss can fetch, so the boss
# guarantees the base before the worker starts.
#
# Fetching is always safe; moving trunk is not, so the update is limited to one case: the local
# trunk is a clean, strictly-behind ancestor of origin/<trunk>. A dirty working tree, an ahead
# trunk, or a diverged trunk all refuse the spawn, naming the exact state and the command that
# fixes it. Nothing here resets, rebases, stashes, checks out or forces: that is the owner's
# work to move.
#
# A --cwd that is not a git repo, or has no origin, is skipped with one line: delegation has no
# business demanding git of every worker.
ensure_fresh_trunk() {
	local cwd=$1 branch current ahead behind counts url
	if ! git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
		say "trunk: $cwd is not a git repo, skipping the freshness check" >&2
		return 0
	fi
	url=$(git -C "$cwd" remote get-url origin 2>/dev/null) || url=""
	if [ -z "$url" ]; then
		say "trunk: $cwd has no origin, skipping the freshness check" >&2
		return 0
	fi
	branch=$(fresh_trunk_branch "$cwd")
	if [ -z "$branch" ]; then
		say "trunk: $cwd has no origin/trunk, origin/main or origin/master, skipping the freshness check" >&2
		return 0
	fi
	git -C "$cwd" fetch --prune --quiet origin || die "refusing to spawn: git fetch origin failed in $cwd, so the base cannot be trusted.
Fix remote access there first (ssh -T $url), then spawn again."

	# Trunk is not checked out: move the ref, never the working tree. A fetch into a local branch
	# refuses a non-fast-forward update by itself, so this cannot rewind anyone's trunk.
	current=$(git -C "$cwd" symbolic-ref --quiet --short HEAD 2>/dev/null) || current=""
	if [ "$current" != "$branch" ]; then
		git -C "$cwd" fetch --quiet origin "$branch:$branch" || die "refusing to spawn: local $branch in $cwd is not a fast-forward of origin/$branch, and it is not checked out, so the base cannot be updated safely.
Look before moving it:  git -C $cwd log --oneline --left-right $branch...origin/$branch"
		say "trunk: $branch in $cwd updated to origin/$branch (not checked out; no working tree touched)" >&2
		return 0
	fi

	# On trunk. Dirty first: a fast-forward is a checkout, so it would either fail halfway or
	# carry somebody's uncommitted work onto the new base.
	if [ -n "$(git -C "$cwd" status --porcelain 2>/dev/null)" ]; then
		die "refusing to spawn: $cwd is on $branch with a dirty working tree, so trunk cannot be fast-forwarded to origin/$branch.
Commit, stash or discard it first:  git -C $cwd stash -u"
	fi
	counts=$(git -C "$cwd" rev-list --left-right --count "HEAD...origin/$branch" 2>/dev/null | tr '\t' ' ') || counts="0 0"
	ahead=${counts%% *}
	behind=${counts##* }
	if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then
		say "trunk: $branch in $cwd is up to date with origin/$branch" >&2
		return 0
	fi
	if [ "$ahead" != 0 ] && [ "$behind" != 0 ]; then
		die "refusing to spawn: $branch in $cwd has diverged from origin/$branch ($ahead ahead, $behind behind).
Move it yourself — rebase or merge origin/$branch, or move the work onto a branch — then spawn again:  git -C $cwd pull --rebase origin $branch"
	fi
	if [ "$ahead" != 0 ]; then
		die "refusing to spawn: $branch in $cwd is $ahead commit(s) ahead of origin/$branch and nothing behind. Unpushed trunk is not a base to cut a worker's branch from.
Push it, or move it onto a branch, then spawn again:  git -C $cwd log --oneline origin/$branch..$branch"
	fi
	git -C "$cwd" merge --ff-only --quiet "origin/$branch" || die "refusing to spawn: could not fast-forward $branch in $cwd to origin/$branch; the git merge --ff-only error above says why."
	say "trunk: fast-forwarded $branch in $cwd by $behind commit(s) to origin/$branch" >&2
}

# acceptance_source_spec <task> <cwd> — the spec file an acceptance-test worker reads.
#
# The task is the path itself, or text that names one ("specs/login.md, the magic-link flow"),
# so the first word ending in .md is taken as the candidate. It is resolved against the worker's
# cwd first and the boss's specs/ second, and it must end up inside a specs/ directory: the whole
# point of the mode is that the tests come from spec text, and text that is not a spec is just
# another instruction. Prints the absolute path, exits nonzero when there is no such file.
acceptance_source_spec() {
	local task=${1:-} cwd=${2:-} word cand
	for word in $task; do
		case $word in *.md|*.md[,.\;:]*) word=${word%%[,;:]*}; cand=$word; break ;; esac
	done
	[ -n "${cand:-}" ] || return 1
	local try
	for try in "$cwd/$cand" "$SPECS/${cand##*/}" "$ROOT/$cand"; do
		[ -f "$try" ] || continue
		local real dir
		real=$(readlink -f -- "$try")
		dir=$(dirname -- "$real")
		[ "$(basename -- "$dir")" = specs ] || continue
		printf '%s' "$real"
		return 0
	done
	return 1
}

cmd_spawn() {
	local slug="" cwd="" mode="" thinking="" task="" override_jev=0 reason="" runner="" no_restore=0 acceptance=0
	[ "$#" -ge 1 ] || die 'usage: delegate spawn <slug> --cwd DIR [--mode M] [--thinking LEVEL] [--acceptance] [--override-jev --reason TEXT] [--no-restore] "<task>"'
	slug=$1; shift
	local words=()
	while [ "$#" -gt 0 ]; do
		case $1 in
		--cwd) cwd=${2:-}; shift 2 ;;
		--mode) mode=${2:-}; shift 2 ;;
		--thinking) thinking=${2:-}; shift 2 ;;
		--acceptance) acceptance=1; shift ;;
		--override-jev) override_jev=1; shift ;;
		--reason) reason=${2:-}; shift 2 ;;
		--no-restore) no_restore=1; shift ;;
		--*) die "unknown option $1" ;;
		*) words+=("$1"); shift ;;
		esac
	done
	task="${words[*]:-}"
	valid_slug "$slug" || die "slug must match [a-z0-9][a-z0-9-]{0,30}: '$slug'"
	[ -n "$cwd" ] || die "spawn needs --cwd: the directory the worker works in"
	[ -d "$cwd" ] || die "no such directory: $cwd"
	[ -n "$task" ] || die "spawn needs a task description"
	case $thinking in
	"" | off | minimal | low | medium | high | xhigh | max) ;;
	*) die "thinking must be off, minimal, low, medium, high, xhigh or max: '$thinking'" ;;
	esac
	cwd=$(readlink -f -- "$cwd")
	# --acceptance: the task text is, or names, a file under specs/. A second opinion that has not
	# seen the implementation is only worth having if what it was given actually exists, so this
	# is checked before jev is asked anything.
	local source_spec=""
	if [ "$acceptance" = 1 ]; then
		source_spec=$(acceptance_source_spec "$task" "$cwd") ||
			die "--acceptance needs a spec file under specs/ as the task: '${task}' names no such file"
		[ "$source_spec" != "$SPECS/$slug.md" ] ||
			die "--acceptance reads a spec, it does not write its own: '$slug' would overwrite $source_spec. Pick another slug."
	fi
	need herdr-app; need node; need hc

	# 1. Jev decides the count, the mode, the route and the thinking effort. Always. No caller
	#    short-circuit. One call answers all four (see plan_jev); each answer is still checked and
	#    still recorded on its own line below, so a reader cannot tell the difference in the log.
	local jev_count jev_mode jev_route jev_effort plan_reason overridden=false
	local count_reason mode_reason route_reason thinking_reason
	local mode_overridden=false thinking_overridden=false route_overridden=false
	local task_ctx="spawn:$slug"
	plan_jev "$task" "$task_ctx"
	jev_count=$JEV_COUNT
	jev_mode=$JEV_MODE
	jev_route=$JEV_ROUTE
	jev_effort=$JEV_THINKING
	plan_reason=$JEV_REASON
	# One reason for four decisions: jev gave one sentence for one judgement, and a line that
	# invented three more would be recording prose nobody wrote.
	count_reason=$plan_reason
	mode_reason=$plan_reason
	route_reason=$plan_reason
	thinking_reason=$plan_reason
	# The effort is Jev's; the level is the model's. See worker_thinking_level.
	local thinking_map jev_level jev_effort_level
	thinking_map=$(worker_thinking_level "$jev_effort")
	jev_level=$(printf '%s' "$thinking_map" | json_field level)
	[ -n "$jev_level" ] || die "could not map jev's thinking effort '$jev_effort' to a level: $thinking_map"
	jev_effort_level=$jev_level

	# 2. A caller's mode and thinking level must agree with Jev for this exact task text, and a
	#    task Jev calls local refuses: local work needs no space, no spec and no agent.
	#    Jev's answer is recorded either way: a refusal is a decision too, and the audit line
	#    says why nothing spawned. An override without a reason is a guess, so it refuses too.
	local refusal="" refuse_mode=0 refuse_thinking=0 refuse_route=0 reason_given=0
	if [ -n "$mode" ] && [ "$mode" != "$jev_mode" ]; then refuse_mode=1; fi
	if [ -n "$thinking" ] && [ "$thinking" != "$jev_level" ]; then refuse_thinking=1; fi
	if [ "$jev_route" = local ]; then refuse_route=1; fi
	if [ -n "${reason// /}" ]; then reason_given=1; fi

	if [ "$override_jev" = 1 ] && [ "$reason_given" = 0 ]; then
		refusal="--override-jev needs a non-empty --reason: an override without a reason is a guess"
	elif [ "$override_jev" = 1 ]; then
		# An override is per decision: only the line whose answer the caller contradicted is
		# marked. Nothing to overrule is not an override.
		if [ "$refuse_mode" = 1 ]; then mode_overridden=true; fi
		if [ "$refuse_thinking" = 1 ]; then thinking_overridden=true; fi
		if [ "$refuse_route" = 1 ]; then route_overridden=true; fi
		if [ "$mode_overridden" = true ] || [ "$thinking_overridden" = true ] || [ "$route_overridden" = true ]; then
			overridden=true
		fi
	elif [ "$refuse_mode" = 1 ]; then
		refusal="--mode $mode contradicts jev, which answered '$jev_mode' for this task ($mode_reason).
Re-run without --mode to use jev's answer, or re-run with --override-jev --reason '<why>' to overturn jev."
	elif [ "$refuse_thinking" = 1 ]; then
		refusal="--thinking $thinking contradicts jev, which answered effort '$jev_effort' — level '$jev_level' for this task ($thinking_reason).
Re-run without --thinking to use jev's level, or re-run with --override-jev --reason '<why>' to overturn jev."
	elif [ "$refuse_route" = 1 ]; then
		refusal="jev routes this task local, so a space and an agent are more than it needs ($route_reason).
Run it here instead:  $BIN/local-run \"<task>\"
Forcing a remote worker needs --override-jev --reason '<why this cannot run locally>'."
	fi

	if [ -n "$refusal" ]; then
		record_decision mode "$task" "$jev_mode" "$mode_reason" false "-" "$jev_mode"
		record_decision count "$task" "$jev_count" "$count_reason" false "-" "$jev_count"
		record_decision route "$task" "$jev_route" "$route_reason" false "-" "$jev_route"
		record_decision thinking "$task" "$jev_level" "$thinking_reason (jev effort $jev_effort → $jev_level)" false "-" "$jev_level"
		die "$refusal"
	fi

	if [ -z "$mode" ]; then mode=$jev_mode; fi
	# A --thinking that survives to here either agrees with jev or was overridden on purpose.
	if [ -z "$thinking" ] || [ "$refuse_thinking" != 1 ]; then thinking=$jev_level; fi
	jev_level=$thinking
	case $mode in bare|sandboxed) runner=$BIN/pi-$mode ;; no-net) runner=$BIN/pi-nonet ;; *) die "mode must be bare, sandboxed or no-net: '$mode'" ;; esac
	[ -f "$runner" ] || die "no runner for mode $mode ($runner)"

	# 3. A local route survives only as an override, and the note says so out loud.
	if [ "$jev_route" = local ]; then
		printf '%s: note: jev routes this task local (%s); spawning because --override-jev --reason was given.\n' "$prog" "$route_reason" >&2
	fi

	# 4. Record all four decisions before doing any work. `overridden` sits on the line whose
	#    decision was actually overturned, and `jev` carries jev's own answer on every line.
	record_decision mode "$task" "$mode" "$mode_reason" "$mode_overridden" "$slug" "$jev_mode"
	record_decision count "$task" "$jev_count" "$count_reason" false "$slug" "$jev_count"
	record_decision route "$task" "$jev_route" "$route_reason" "$route_overridden" "$slug" "$jev_route"
	record_decision thinking "$task" "$jev_level" "$thinking_reason (jev effort $jev_effort → $jev_level)" "$thinking_overridden" "$slug" "$jev_effort_level"

	# The review ceiling is 4 workers (blip 21) and 8 live spaces is the hard stop. Jev's count is
	# honoured or the spawn refuses: starting one worker for a three-worker task is a decision
	# nobody made, and the person then believes three areas are being worked at once.
	local live
	live=$(node -e '
		const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
		process.stdout.write(String(Object.keys(j).length));' "$DELEGATIONS" 2>/dev/null || echo 0)
	if [ $((live + jev_count)) -gt 8 ]; then
		die "$live workers already tracked and jev asks for $jev_count more, past the live ceiling of 8 — close finished ones first, or split the task."
	fi
	# A count of N needs N slugs, and a slug is at most 31 characters; "-2" .. "-4" is what is
	# appended, so a shorter slug is the only thing that has to change.
	if [ "$jev_count" -gt 1 ] && [ "${#slug}" -gt 29 ]; then
		die "jev wants $jev_count workers, named $slug-2 .. $slug-$jev_count, and a slug is at most 31 characters: use a slug of at most 29 characters."
	fi

	# 4b. Review sets the pace in the area the work is in, not across the whole directory. An
	#     unread report blocks only when the worker's branch touches a path this task names; the
	#     worker's side comes from its branch diff, this task's side from its own text. Both lists
	#     go into the refusal, because "overlaps" without the paths is a claim, not a finding.
	#     No paths named means no overlap established — recorded and said out loud, never silent.
	local unread uslug uage ureport ubranch wpaths hits tpaths tpaths_one blocking="" quiet=""
	tpaths=$(task_paths "$task")
	tpaths_one=$(printf '%s\n' "$tpaths" | paste -sd' ' -)
	unread=$(unread_reports_in "$cwd")
	while read -r uslug uage ureport ubranch; do
		[ -n "${uslug:-}" ] || continue
		wpaths=$(worker_paths "$cwd" "$ubranch")
		hits=$(paths_overlap "$wpaths" "$tpaths")
		if [ -n "$hits" ]; then
			blocking="${blocking:+$blocking; }$uslug (reported ${uage}s ago, $ureport) touches: $(printf '%s\n' "${wpaths:-unknown}" | paste -sd' ' -); this task names: $(printf '%s\n' "$hits" | paste -sd' ' -)"
		else
			quiet="${quiet:+$quiet; }$uslug (reported ${uage}s ago) touches: $(printf '%s\n' "${wpaths:-nothing}" | paste -sd' ' -)"
		fi
	done <<<"$unread"

	if [ -n "$blocking" ]; then
		if [ "$override_jev" != 1 ]; then
			record_decision in-flight "$task" blocked "$blocking" false "-"
			die "refusing to spawn in $cwd: a report there is still unread — $blocking
This task names: ${tpaths_one:-no path at all}.
Review sets the pace, not generation. Read it, then spawn again:  $BIN/delegate wait <slug>  marks the report read as it prints it.
Forcing a second worker in the same area needs --override-jev --reason '<why the queue can wait>'."
		fi
		record_decision in-flight "$task" override "$reason — blocked by: $blocking" true "$slug"
		printf '%s: note: an unread report in %s touches a path this task names (%s); spawning because --override-jev --reason was given.\n' "$prog" "$cwd" "$blocking" >&2
	elif [ -n "$quiet" ]; then
		record_decision in-flight "$task" allowed "no overlap with the unread report(s): $quiet; this task names: ${tpaths_one:-no path}" false "$slug"
		printf '%s: note: unread report(s) in %s touch no path this task names (%s): %s — spawning.\n' "$prog" "$cwd" "${tpaths_one:-the task names no path, so this is no overlap established}" "$quiet" >&2
	fi

	# 5. Guarantee the base before anything is created. The fetch works here and not inside a
	#    sandboxed worker, so the worker's trunk is fresh by construction, not by hope.
	ensure_fresh_trunk "$cwd"

	# The branch the boss's tree is on right now. A worker must cut its own worktree from it, and
	# cmd_close compares against this: a worker that switches the live checkout gets caught and
	# the tree put back, even when the rule in the spec was ignored. Empty outside a git repo.
	local base_branch=""
	if command -v git >/dev/null 2>&1; then
		base_branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
	fi

	mkdir -p "$SPECS" "$REPORTS" "$STATE"
	# overridden is the word "false" when nothing was overridden: test it, do not test for a value.
	local overridden_note=""
	if [ "$overridden" = true ]; then overridden_note=", overridden: $reason"; fi
	# Acceptance mode rewrites the task section and adds one rule block. Everything else — the
	# mission line, the worktree rule, the report shape — is the same worker, so it is the same
	# template rather than a second one that drifts.
	local acceptance_note="" acceptance_block="" acceptance_task="" task_block=$task base_task=$task
	local acceptance_bool=false
	if [ "$acceptance" = 1 ]; then
		acceptance_bool=true
		acceptance_note=", acceptance: true"
		acceptance_task="Acceptance tests for the spec at \`$source_spec\`. You are the second opinion: the
spec is your whole input, and the implementation is not."
		acceptance_block=$(cat <<ACCEPTANCE

## Acceptance mode

You write the tests from the spec text alone and never see what was built. A test written by
someone who has read the code can be bent to fit it, and then it proves nothing; that distance is
the only reason this worker exists.

1. Read only \`$source_spec\` and the interface files it names by path — a header, a type
   declaration, a documented entry point. Never open the implementation files of the change: not
   to check a name, not to see how it is wired. A path the spec does not name is not yours to read.
2. Write one failing test per behaviour the spec states: the commands, inputs, outputs and
   refusals it names. Not one more, not one guess at an unstated case.
3. Ambiguity is not yours to resolve. Where the spec does not say what should happen, make the
   first line of your report \`DECISION NEEDED: <the question in one line>\` and stop.
4. Commit only test files. Production code stays untouched — a failing test is the deliverable,
   and an implementation written here would defeat the point.
5. The report must show the tests failing against the current tree, with the output that shows
   it. If they pass, say which it is: the work is already done, or the tests do not test the spec.
ACCEPTANCE
)
	fi

	# One space per worker jev asked for: SLUG, SLUG-2 .. SLUG-N. Every one gets its own spec, its
	# own report path, its own space, and the same mode and thinking level. The task text carries
	# the worker's position, so its report reads as one of a group instead of as the whole job.
	local n spawn_slug spec report argv before out space tab pane terminal position
	for n in $(seq 1 "$jev_count"); do
		if [ "$n" = 1 ]; then spawn_slug=$slug; else spawn_slug=$slug-$n; fi
		spec=$SPECS/$spawn_slug.md
		report=$REPORTS/$spawn_slug.md
		position=""
		if [ "$jev_count" -gt 1 ]; then
			position="This is worker $n of $jev_count started for this task at the same moment, each in
its own worktree with its own report. Do not expect the other workers' changes in your tree, and
do not edit anyone else's report."
		fi
		task_block=$base_task
		if [ "$acceptance" = 1 ]; then task_block=$acceptance_task; fi
		if [ -n "$position" ]; then
			task_block="$task_block

$position"
		fi
		cat >"$spec" <<EOF
# Worker \`$spawn_slug\`

You are the genie. Your work is plausible by default. Prove it runs.

Report to the agent in the big-boss-pi workspace that started you; it is waiting on
\`$report\`.

- **Mission**: who is better off, and how we would see it. One line: the person or system that
  gains, and the observation that shows the gain. Every effort number (LOC, tokens, files, agent
  count) is cost, never progress — leave it out of the mission.
- **Iteration**: expect two or more cycles. You may throw this away.
- **Spec history**: before you start, read the most recent spec in \`specs/archive/\` for the area
  you are working in — it is the previous decision in this place. If there is none, say so in the
  report instead of leaving the reader to guess.
- Work in: \`$cwd\`
- Mode: \`$mode\` (chosen by jev$overridden_note), route: $jev_route (jev), thinking: \`$jev_level\` (jev: $jev_effort)
- Report file: \`$report\`

## Task

$task_block
$acceptance_block

## Rules

1. Do the task in \`$cwd\`. Do not touch \`$ROOT\` (write a report, nothing else).
2. Never switch the checkout you were given: \`$cwd\` is the boss's tree, which keeps reading it,
   and a checkout in place breaks its commands mid-run. Cut your own worktree first — from
   \`$cwd\`: \`git worktree add ../SLUG-worktree -b BRANCH\` — and do all work there. Never run
   \`git checkout\`, \`git switch\`, \`git stash\` or \`git reset\` in \`$cwd\`.
3. Before doing any work, ask Jev the route: \`$BIN/jev route "<the task, one line>"\`. If it
   says \`local\`, do not grind it out as a coding job: run it as
   \`$BIN/local-run "<the task>"\` (or pipe the text in) and put the answer in the report.
   Remote is what you are for; local work in a worker space is the mismatch this rule catches.
4. Do not spawn other agents or Herdr spaces, and do not rename, move or close any space.
   If the task needs more hands, say so in the report.
5. Every change lands as a pull request, and you do not publish it. Commit on your branch and
   stop there: do not upload the branch, do not create the pull request - not even to try, there
   is no fallback. Put the branch name and the commit sha in the report and say the boss
   publishes it. State the review tier in the report so the PR body can carry it (low: docs,
   comments, formatting; medium: application code, tests, migrations; high: extensions,
   AGENTS.md, .github/, git-hooks/, sandbox/, auth, secrets, money, deletion). Never merge,
   never upload onto trunk, never commit on trunk. You stay sandboxed: publishing is the boss's
   job, so it never needs host access from you.
6. End every commit message with two trailers: \`Agent-Slug: $spawn_slug\` and \`Spec: $SPECS/$spawn_slug.md\`.
   \`delegate close\` refuses a report whose recorded commit sha has no \`Agent-Slug\` trailer,
   so a commit without them cannot close its own worker. AGENT_SLUG=$spawn_slug is already in your
   environment and the commit-msg hook stamps both trailers, so a plain \`git commit\` carries
   them; check with \`git log -1 --format=%B\` before you report, and only amend if the hook
   was not installed.
7. When you are done — or blocked and unable to continue — write \`$report\` with:
   - **Mission**: who is better off now, and how we would see it. The same line the spec gave
     you, updated with what actually happened. No LOC, no token counts, no file counts, no
     "N agents": effort is not mission, and output volume is not correctness.
   - what now works, in concrete terms (a command to run, a path, a test that passes)
   - what you changed: the branch, and one \`Commit: <sha>\` line with the commit that carries
     the work (the close checks its \`Agent-Slug\` trailer), plus the files and the PR URL or the
     branch to publish
   - what is still open, and the one next action for the person
   - \`## Evidence\` — mandatory, and the only part a reader has to trust: the exact command
     you ran and the last 20 lines of its output, pasted in a fenced block. \`delegate close\`
     refuses a report without this block, so a missing one keeps your space open.
   - \`## Thrown away\` — what you deleted or rewrote on purpose, and why. A rewrite is a
     credited outcome, not a confession; "nothing" is a fine answer when it is written down.
   - \`## What I would do differently next time\` — one or two lines. The next worker reads
     this one, and a lesson kept costs a line.
   Keep it short. That file is the whole message back; nobody reads your scrollback.
8. Never write "should work", "looks correct" or "tests pass" without the output that shows
   it. If it was not run, write "not run" and what would run it. A claim without output is
   not a result, and the report is read as a claim until the Evidence block proves it.

The report's Evidence block is scaffolded here, prefilled, so that leaving it out is a decision
and not an oversight. Copy this into your report and replace the two pointy-bracket lines:

\`\`\`\`markdown
## Evidence

Command: <fill in: the exact command you ran, flags and all>

Output (last 20 lines):

\`\`\`
<paste the last 20 lines of that command's output here>
\`\`\`
\`\`\`\`

\`delegate close\` refuses a report with no Evidence block, and refuses one whose placeholders were
left in. That is the point: a report without output is a claim, and the harness does not close on a
claim.

9. Then write the report and stay idle. Do not close, rename or move the space. The
   big-boss-pi agent relays the report and closes the space right away, so a space never stays
   open just because the worker finished.
10. The one exception, when the user must decide something before work can continue: make the
   first line of the report read "DECISION NEEDED: the question in one line". That marker is
   the only thing that keeps the space open, and only until the user answers.
EOF

	argv=$(node -e 'process.stdout.write(JSON.stringify(["sh","-lc",process.argv[1]]))' \
		"cd $(printf '%q' "$cwd") && export AGENT_SLUG=$(printf '%q' "$spawn_slug") && exec $(printf '%q' "$runner") --thinking $(printf '%q' "$jev_level") -a")
	# space.new has no hidden or background mode: the new space is shown, which takes the person
	# off the space and tab they were reading. Note both ids now, explicitly, to put them back.
	before=""
	if [ "$no_restore" = 0 ]; then before=$(screen_state); fi

	out=$(herdr-app do space.new --name "$spawn_slug" --folder "$cwd" --tab "$spawn_slug" \
		--argv "$argv" --task "Read $spec and do it. Report to $report." 2>&1) \
		|| die "space.new failed for $spawn_slug: $out"

	space=$(printf '%s' "$out" | json_field space)
	[ -n "$space" ] || space=$(printf '%s' "$out" | json_field id)
	tab=$(printf '%s' "$out" | json_field tab)
	pane=$(printf '%s' "$out" | json_field pane)
	terminal=$(printf '%s' "$out" | json_field terminal)

	# Put the view back before anything slow happens: state, the task send, the banner wait.
	# Each failure is one warning line, never a refusal, and --no-restore skips it entirely.
	if [ "$no_restore" = 0 ]; then
		if [ -z "$before" ]; then
			printf '%s: warning: could not read the space on screen before the spawn, so focus stayed on space %s\n' "$prog" "${space:-?}" >&2
		elif ! restore_focus "${before%% *}" "${before##* }"; then
			printf '%s: warning: could not restore focus to space %s, so focus stayed on space %s\n' "$prog" "${before%% *}" "${space:-?}" >&2
		fi
	fi

	[ -n "$space" ] || die "could not read the new space id from: $out"

	node -e '
		const fs=require("fs");const [state,slug,space,tab,pane,terminal,cwd,mode,thinking,spec,report,jevCount,jevEffort,overridden,reason,branch,acceptance,sourceSpec]=process.argv.slice(1);
		let j={};try{j=JSON.parse(fs.readFileSync(state,"utf8"))}catch{}
		j[slug]={slug,space,tab,pane,terminal,cwd,mode,thinking,thinkingEffort:jevEffort,spec,report,jevCount:Number(jevCount),
			overridden:overridden==="true",overrideReason:reason||null,branch:branch||null,acceptance:acceptance==="true",
			acceptanceSpec:sourceSpec||null,started:new Date().toISOString()};
		fs.writeFileSync(state,JSON.stringify(j,null,2)+"\n");' \
		"$DELEGATIONS" "$spawn_slug" "$space" "$tab" "$pane" "$terminal" "$cwd" "$mode" "$thinking" "$spec" "$report" \
		"$jev_count" "$jev_effort" "$overridden" "$reason" "$base_branch" "$acceptance_bool" "$source_spec"

	# space.new's --task can arrive before pi is listening, so send it again once the banner is up.
	local i
	for i in $(seq 1 40); do
		hc read "$terminal" 2>/dev/null | grep -q "escape interrupt" && break
		sleep 1
	done
	hc send "$terminal" "Read $spec and do it. Report to $report." >/dev/null 2>&1 \
		|| printf '%s: warning: could not send the task to %s\n' "$prog" "$terminal" >&2

	printf '{"slug":"%s","space":"%s","mode":"%s","thinking":"%s","thinking_effort":"%s","route":"%s","jev_count":%s,"overridden":%s,"acceptance":%s,"cwd":"%s","report":"%s","branch":"%s"}\n' \
		"$spawn_slug" "$space" "$mode" "$jev_level" "$jev_effort" "$jev_route" "$jev_count" "$overridden" "$acceptance_bool" "$cwd" "$report" "$base_branch"
	done
}

cmd_wait() {
	local slug=${1:-}; local timeout=600
	[ -n "$slug" ] || die 'usage: delegate wait <slug> [--timeout SECONDS]'
	shift || true
	while [ "$#" -gt 0 ]; do
		case $1 in
		--timeout) timeout=${2:-600}; shift 2 ;;
		*) die "unknown option $1" ;;
		esac
	done
	local report=$REPORTS/$slug.md
	command -v timeout >/dev/null 2>&1 || die "timeout not found"
	local waited=0
	while [ "$waited" -lt "$timeout" ]; do
		if [ -s "$report" ]; then
			say "== $slug reported =="
			cat "$report"
			# Printing the report is reading it: the marker clears this cwd's in-flight block.
			mark_read "$slug"
			say ""
			if report_needs_decision "$report"; then
				say "$slug asks the user for a decision. Relay the question, and close the space once it is answered:"
			else
				say "$slug is done. Relay the report, then close the space now:"
			fi
			say "  $BIN/delegate close $slug"
			return 0
		fi
		sleep 2; waited=$((waited + 2))
	done
	die "$slug has not reported after ${timeout}s — ask the user whether to keep waiting"
}

cmd_list() {
	[ -f "$DELEGATIONS" ] || { say "no workers"; return 0; }
	node -e '
		const fs=require("fs");
		let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
		let decisions=[];
		try{decisions=fs.readFileSync(process.argv[2],"utf8").trim().split("\n").filter(Boolean).map(l=>{try{return JSON.parse(l)}catch{return null}}).filter(Boolean)}catch{}
		// One map per worker, keyed by command: mode, route and thinking are separate lines, and
		// the last command to land is not the only one worth showing.
		const by=new Map();
		for(const d of decisions)if(d.slug){
			if(!by.has(d.slug))by.set(d.slug,new Map());
			by.get(d.slug).set(d.command,d);
		}
		const pick=(slug,cmd)=>{const m=by.get(slug);return m?m.get(cmd):undefined};
		const rows=Object.values(j);
		if(!rows.length){console.log("no workers");process.exit(0)}
		for(const r of rows){
			let size=0;try{size=fs.statSync(r.report).size}catch{}
			const mode=pick(r.slug,"mode"),route=pick(r.slug,"route"),think=pick(r.slug,"thinking");
			const level=(think?think.decision:r.thinking)||"?";
			const overridden=(mode&&mode.overridden)||(think&&think.overridden)||r.overridden;
			const jev=`mode=${r.mode} route=${route?route.decision:"?"} thinking=${level}${overridden?" (overridden)":""}`;
			console.log([r.slug.padEnd(22),r.mode.padEnd(10),level.padEnd(8),(size?"reported":"working").padEnd(9),jev.padEnd(44),r.space,"cwd="+r.cwd].join(" "));
		}' "$DELEGATIONS" "$DECISIONS"
}

# ask — put a question to Jev before it reaches the user. The question is not the person's to
# answer until Jev says it is.
#
# "Ask jev before you ask the user" is a rule; this makes it checkable instead of remembered.
# Every question that goes through here leaves the same audit line in state/decisions.jsonl
# (command "ask"), and the exit code says what to do next: 0 yes, 1 no — act on it, do not
# interrupt the user — and 3 unsure or model unreachable, the only case that reaches the user,
# carrying Jev's answer and reason in one line. The user is the tie-breaker, not the first
# responder.
cmd_ask() {
	local question="" json=0 out rc decision reason
	[ "$#" -ge 1 ] || die 'usage: delegate ask "<question for jev>" [--json]'
	while [ "$#" -gt 0 ]; do
		case $1 in
		--json) json=1; shift ;;
		--*) die "unknown option $1" ;;
		*) question="${question:+$question }$1"; shift ;;
		esac
	done
	[ -n "${question// /}" ] || die 'usage: delegate ask "<question for jev>" [--json]'
	need node
	out=$(PI_BOSS_CONTEXT="ask" "$BIN/jev" ask "$question" --json 2>&1) && rc=0 || rc=$?
	decision=$(printf '%s' "$out" | json_field decision)
	reason=$(printf '%s' "$out" | json_field reason)
	case $rc in
	0) decision=yes ;;
	1) decision=no ;;
	*) decision=unsure ;;
	esac
	# An unreachable model leaves no reason behind, only jev's own complaint. Keep that line:
	# the one sentence the user sees has to explain itself.
	if [ -z "$reason" ]; then
		reason=$(printf '%s' "$out" | head -n 1 | sed 's/^[^:]*: //')
	fi
	record_decision ask "$question" "$decision" "$reason" false "-" "$decision"
	if [ "$json" = 1 ]; then
		node -e 'const [q,d,r]=process.argv.slice(1);process.stdout.write(JSON.stringify({question:q,decision:d,reason:r||null,ask_user:d==="unsure"})+"\n")' \
			"$question" "$decision" "$reason"
		return "$rc"
	fi
	case $decision in
	yes)
		say "jev: yes${reason:+ — $reason}"
		say "Act on that answer. Do not ask the user."
		;;
	no)
		say "jev: no${reason:+ — $reason}"
		say "Act on that answer. Do not ask the user. Overturning jev is the user's call, not yours."
		;;
	*)
		say "jev: unsure${reason:+ — $reason}"
		say "Now ask the user, and carry that line: \"jev is unsure — $reason\"."
		;;
	esac
	return "$rc"
}

# cmd_wipe -- the consolidation step between features: five questions, then a line in the log.
#
# It is a gate, not a report: the answers belong in the worker's report (`## Thrown away`) and in
# AGENTS.md only when they generalise, so this prints the questions and records that the step
# happened. Effort spent here is the only thing that turns a finished feature into a cheaper
# codebase; without it every feature is an addition and the tree only grows.
cmd_wipe() {
	local slug=${1:-} skip=0 reason="" branch=""
	[ -n "$slug" ] || die 'usage: delegate wipe <slug> [--skip "<reason>"]'
	shift || true
	while [ "$#" -gt 0 ]; do
		case $1 in
		--skip)
			skip=1
			reason=${2:-}
			[ -n "${reason// /}" ] || die "--skip needs a reason: delegate wipe $slug --skip \"<why the step does not apply>\""
			shift 2
			;;
		*) die "unknown option $1" ;;
		esac
	done
	# A wipe on a slug nobody spawned wipes nothing and records nothing useful, and the answers
	# would go into a report that does not exist. Refuse it the way close does: loud, nonzero,
	# and naming the word that was wrong.
	[ -f "$DELEGATIONS" ] || die "no such worker: $slug"
	known=$(node -e 'const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}process.stdout.write(j[process.argv[2]]?"1":"0")' \
		"$DELEGATIONS" "$slug") || known=0
	[ "$known" = 1 ] || die "no such worker: $slug"
	branch=$(node -e 'const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}process.stdout.write((j[process.argv[2]]||{}).branch||"")' \
		"$DELEGATIONS" "$slug") || branch=""

	if [ "$skip" = 1 ]; then
		record_decision wipe "$slug" skipped "$reason" false "$slug"
		say "wipe: $slug — skipped, reason recorded: $reason"
		say "state/decisions.jsonl holds the line; close goes through:  $BIN/delegate close $slug"
		return 0
	fi

	say "wipe: $slug — five answers before the next feature starts${branch:+ (branch $branch)}:"
	say "  1. Deleted?      what did this make unnecessary, and is that code gone?"
	say "  2. Duplicated?   what here is a second copy of something already in the tree?"
	say "  3. Next feature? could one land in this area in 30 minutes, or does it need a rewrite?"
	say "  4. Learned?      what belongs in AGENTS.md or a comment after this?"
	say "  5. Rewrite?      what would you re-implement from scratch, and why?"
	say ""
	say "Write the answers into the report (## Thrown away), then this line records the step."
	# Spec continuity (Radar blip 82): a finished spec moves out of specs/ into specs/archive/, where
# the next worker in the same area reads it before it starts. A spec nobody archives is one the
# next worker re-decides from nothing.
local spec=$SPECS/$slug.md
if [ -f "$spec" ]; then
	mkdir -p "$SPECS/archive"
	mv "$spec" "$SPECS/archive/$slug.md"
	say "spec archived: specs/archive/$slug.md — the next worker in this area reads it first"
fi
	record_decision wipe "$slug" done "" false "$slug"
	say "state/decisions.jsonl: wipe done for $slug — close goes through:  $BIN/delegate close $slug"
}

cmd_close() {
	local slug=${1:-} merged="" nothing="" nothing_given=""
	[ "$#" -ge 1 ] || die 'usage: delegate close <slug> [--merged <pr-url-or-number>] [--nothing "<why nothing landed>"]'
	slug=$1; shift
	while [ "$#" -gt 0 ]; do
		case $1 in
		--merged) merged=${2:-}; shift 2 ;;
		--nothing)
			nothing=${2:-}; nothing_given=1
			if [ "$#" -ge 2 ]; then shift 2; else shift 1; fi
			;;
		--*) die "unknown option $1" ;;
		*) die "close takes one slug: '$1' — usage: delegate close <slug> [--merged <pr-url-or-number>] [--nothing \"<why nothing landed>\"]" ;;
		esac
	done
	[ -n "$slug" ] || die 'usage: delegate close <slug> [--merged <pr-url-or-number>] [--nothing "<why nothing landed>"]'
	# --nothing and --merged answer the same question ("where did the work go?") with opposite
	# findings, so asking both is a mistake, not a combination.
	if [ -n "$nothing_given" ] && [ -n "$merged" ]; then
		die "--nothing and --merged cannot be combined: --nothing says no commit landed, --merged names the PR that carried one"
	fi
	if [ -n "$nothing_given" ] && [ -z "$nothing" ]; then
		die "--nothing needs a reason: delegate close $slug --nothing \"<why this worker landed no commit>\""
	fi
	[ -f "$DELEGATIONS" ] || die "no such worker: $slug"
	local space cwd branch meta report
	meta=$(node -e '
		const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
		const e=j[process.argv[2]]||{};
		process.stdout.write(JSON.stringify({space:e.space||"",cwd:e.cwd||"",branch:e.branch||""}))' "$DELEGATIONS" "$slug")
	space=$(printf '%s' "$meta" | json_field space)
	[ -n "$space" ] || die "no such worker: $slug"
	cwd=$(printf '%s' "$meta" | json_field cwd)
	branch=$(printf '%s' "$meta" | json_field branch)

	# Evidence before the space goes: a close is the last moment a claim can be checked, and a
	# closed worker is not coming back to paste the output. Refuse, name what is missing, and
	# leave the space open — the fix is one edit to the report, then this command again.
	report=$REPORTS/$slug.md
	if [ -s "$report" ]; then
		if ! report_has_evidence "$report"; then
			printf '%s: refusing to close %s: %s has no Evidence block, so the report proves nothing.\n' "$prog" "$slug" "$report" >&2
			printf 'Fix: add a "## Evidence" heading with the exact command you ran and the last 20 lines of its output, then close again:\n' >&2
			printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
		local placeholders
		placeholders=$(report_placeholders "$report")
		if [ -n "$placeholders" ]; then
			printf '%s: refusing to close %s: %s still has fill-in placeholders.\n' "$prog" "$slug" "$report" >&2
			printf '%s\n' "$placeholders" | head -n 5 | sed "s|^|  $report:|" >&2
			printf 'Fix: replace each of them with the real value or delete the line, then close again:\n' >&2
			printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
	fi

	# --nothing (a worker that legitimately landed no commit): a PR merged before the work finished,
	# or the change it was sent for turned out to be unnecessary. Without this the report is refused
	# forever for recording no sha, and the worker is tracked for nothing — so there is one exit, and
	# it is narrow on purpose: a written reason of real length, an Evidence block, no commit named at
	# all, and the wipe step. The reason is printed and recorded, so the record says why it landed
	# nothing instead of silently forgetting the space. Every other close path keeps its checks.
	if [ -n "$nothing_given" ]; then
		if [ ! -s "$report" ]; then
			printf '%s: refusing to close %s with --nothing: %s does not exist, so there is no report that says why nothing landed.\n' "$prog" "$slug" "$report" >&2
			return 1
		fi
		if ! report_has_evidence "$report"; then
			printf '%s: refusing to close %s with --nothing: %s has no Evidence block, so nothing shows the work was tried.\n' "$prog" "$slug" "$report" >&2
			printf 'Fix: add a "## Evidence" heading with the exact command you ran and the last 20 lines of its output, then close again:\n' >&2
			printf '  %s close %s --nothing "<why nothing landed>"\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
		if [ "${#nothing}" -lt 20 ]; then
			printf '%s: refusing to close %s with --nothing: the reason is %d characters, and a no-op close needs 20 or more — "%s" does not tell the next reader why the worker landed nothing.\n' \
				"$prog" "$slug" "${#nothing}" "$nothing" >&2
			printf 'Fix: say what happened, in one sentence:\n' >&2
			printf '  %s close %s --nothing "the PR merged before the work finished, so nothing was committed"\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
		local nosha nosha_msg=""
		nosha=$(report_commit_sha "$report")
		if [ -n "$nosha" ]; then
			if [ -n "$cwd" ] && [ -d "$cwd" ]; then nosha_msg=$(commit_message "$cwd" "$nosha" || true); fi
			if [ -n "$nosha_msg" ]; then
				printf '%s: refusing to close %s with --nothing: %s records commit %s, and that commit resolves, so something did land — close it the normal way so the commit and its Agent-Slug trailer are checked.\n' \
					"$prog" "$slug" "$report" "$nosha" >&2
				printf 'Fix: drop --nothing and close it on its provenance:\n' >&2
				printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
				return 1
			fi
			printf '%s: refusing to close %s with --nothing: %s names commit %s, and a --nothing close is for a report that names no commit at all.\n' \
				"$prog" "$slug" "$report" "$nosha" >&2
			printf 'Fix: if that commit is the work, record it on the Commit: line and close normally; if nothing landed, remove the Commit line and say why in the --nothing reason:\n' >&2
			printf '  %s close %s --nothing "<why nothing landed>"\n' "$BIN/delegate" "$slug" >&2
			return 1
		fi
	fi

	# Provenance (Radar blip 79): a report names the commit it stands for, and that commit names the
# worker in an Agent-Slug trailer. Refused in the same voice as the evidence block: name what is
# missing, print the exact command that fixes it, leave the space open. Nothing is checked when
# the worker's cwd is not a git repo — there is no commit to resolve a sha against, and a guard
# that refuses every report on a plain folder is a guard nobody keeps. A --nothing close has no
# commit to check by definition, and its own block above has already asked for the rest.
if [ -z "$nothing_given" ] && [ -n "$cwd" ] && [ -d "$cwd" ] && git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
	local sha msg
	sha=$(report_commit_sha "$report")
	if [ -z "$sha" ]; then
		printf '%s: refusing to close %s: %s records no commit sha, so nothing ties the change to this worker.\n' "$prog" "$slug" "$report" >&2
		printf 'Fix: add a line "Commit: <sha>" to the report naming the commit that carries the work, then close again:\n' >&2
		printf '  git -C %q log -1 --format=%%H\n' "$cwd" >&2
		printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
		return 1
	fi
	msg=$(commit_message "$cwd" "$sha" || true)
	if [ -z "$msg" ]; then
		printf '%s: refusing to close %s: %s records commit %s, and it does not resolve in %s, so nobody can check it.\n' "$prog" "$slug" "$report" "$sha" "$cwd" >&2
		printf 'Fix: record the sha of the commit that carries the work, then close again:\n' >&2
		printf '  git -C %q log -1 --format=%%H\n' "$cwd" >&2
		printf '  %s close %s\n' "$BIN/delegate" "$slug" >&2
		return 1
	fi
	if ! printf '%s\n' "$msg" | grep -qE '^Agent-Slug:[[:space:]]*[^[:space:]]'; then
		merged_escape "$slug" "$sha" "$cwd" "$merged" || return 1
	fi
fi

	# The report has been read and checked by the time a close gets here: mark it, so a cwd whose
	# worker just closed is free for the next one.
	mark_read "$slug"

	if ! wipe_recorded "$slug"; then
		printf '%s: refusing to close %s: no wipe step recorded for it.\n' "$prog" "$slug" >&2
		printf 'Run the consolidation step first, or record why it does not apply:\n' >&2
		printf '  %s wipe %s [--skip "<reason>"]\n' "$BIN/delegate" "$slug" >&2
		return 1
	fi

	# A --nothing close is an accepted no-op, and an accepted no-op that leaves no trace is
	# indistinguishable from a worker somebody forgot: print the reason and put it in the log, so
	# the space going away is explained by the record rather than by its absence.
	if [ -n "$nothing_given" ]; then
		printf '%s: closing %s with --nothing: %s\n' "$prog" "$slug" "$nothing" >&2
		record_decision nothing "$slug" accepted "$nothing" false "$slug"
	fi

	herdr-app do space.close --id "$space" --confirmed true >/dev/null 2>&1 \
		|| printf '%s: warning: space.close failed for %s\n' "$prog" "$space" >&2
	node -e '
		const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
		delete j[process.argv[2]];
		fs.writeFileSync(process.argv[1],JSON.stringify(j,null,2)+"\n");' "$DELEGATIONS" "$slug"

	# Catch a worker that switched the boss's live checkout anyway. Non-fatal in both halves: a
	# warning plus a best-effort checkout, never a refused close and never a reset or a force.
	if [ -n "$branch" ] && [ -n "$cwd" ] && [ -d "$cwd" ]; then
		local live=""
		live=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
		if [ -n "$live" ] && [ "$live" != "$branch" ]; then
			printf '%s: warning: %s left %s on %s; it started on %s — putting it back\n' \
				"$prog" "$slug" "$cwd" "$live" "$branch" >&2
			git -C "$cwd" checkout "$branch" >/dev/null 2>&1 \
				|| printf '%s: warning: could not check %s out of %s (dirty tree?); it is still on %s\n' \
					"$prog" "$branch" "$cwd" "$live" >&2
		fi
	fi

	printf '{"closed":"%s","space":"%s"}\n' "$slug" "$space"
}

# cmd_sweep -- close every worker whose report exists and does not need a user decision.
# Kept: no report yet (still working), and a report carrying the DECISION NEEDED marker.
cmd_sweep() {
	local closed=0 kept=0 slug report
	local slugs=""
	if [ -f "$DELEGATIONS" ]; then
		slugs=$(node -e '
			const fs=require("fs");let j={};try{j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"))}catch{}
			Object.keys(j).forEach(k=>process.stdout.write(k+"\n"))' "$DELEGATIONS")
	fi
	# set -euo pipefail: a here-string keeps the read out of a pipeline's exit status.
	while IFS= read -r slug; do
		[ -n "$slug" ] || continue
		report=$REPORTS/$slug.md
		if [ ! -s "$report" ]; then
			say "keep   $slug (still working)"
			kept=$((kept + 1))
			continue
		fi
		if report_needs_decision "$report"; then
			say "keep   $slug (decision needed, ask the user)"
			kept=$((kept + 1))
			continue
		fi
		if cmd_close "$slug" >/dev/null; then
			say "closed $slug"
			closed=$((closed + 1))
		else
			say "keep   $slug (close refused: no evidence block, placeholders left, or no wipe step recorded)"
			kept=$((kept + 1))
		fi
	done <<<"$slugs"
	say "$closed closed, $kept kept"
}

# Dispatch only when executed: sourcing this file just gives you the functions.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	case ${1:-} in
	spawn) shift; cmd_spawn "$@" ;;
	wait) shift; cmd_wait "$@" ;;
	list | ls) cmd_list ;;
	close) shift; cmd_close "$@" ;;
	ask) shift; cmd_ask "$@" ;;
	stats) shift; PI_BOSS_ROOT=$ROOT exec node "$self_bin/stats.mjs" "$@" ;;
	sweep) cmd_sweep ;;
	wipe) shift; cmd_wipe "$@" ;;
	*) die 'usage: delegate spawn|wait|list|close|ask|stats|sweep|wipe ...' ;;
	esac
fi
